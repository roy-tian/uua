#!/usr/bin/env zsh

# uua — Universal Update All
#
# Updates APT packages, Node.js (through nvm), npm, Bun, the global
# npm/bun packages and a set of AI coding CLIs in one run. Every step is
# a job that starts the moment the jobs it builds on have finished, so
# everything that can run at the same time does:
#
#   apt ─────────────────────────→ AI CLIs installed by apt
#   node ─→ npm ─→ npm -g
#               └────────────────→ AI CLIs installed by npm
#   bun ──→ bun -g (after node too)
#       └────────────────────────→ AI CLIs installed by bun
#   AI CLIs with installers of their own, from the start
#
# The registry and release queries all go out first, while the sudo
# password is typed. On a terminal a live board shows every job, what it
# is doing and how far it has got. `uua --help` is the reference for the
# options, what gets removed, and exit status.

UUA_VERSION="0.1.1"

autoload -Uz is-at-least
zmodload zsh/datetime
zmodload zsh/mathfunc
zmodload zsh/parameter
zmodload zsh/system
zmodload -F zsh/stat b:zstat

# Ticks sleep through zselect when it is available, rather than forking
# a sleep process a dozen times a second.
_UUA_ZSELECT=0
zmodload zsh/zselect 2>/dev/null && _UUA_ZSELECT=1

# Options
_UUA_CHECK_ONLY=0
_UUA_PRUNE=0
_UUA_KEEP_LOGS=0
_UUA_NO_COLOR=0
_UUA_VERBOSE=0

# Group filters: --apt / --node / --ai select the group(s) to run;
# _UUA_FILTERED marks that at least one was given.
_UUA_WANT_APT=0
_UUA_WANT_NODE=0
_UUA_WANT_AI=0
_UUA_FILTERED=0

# Outcome counters: every reported item lands in exactly one of these.
# Tools that are not installed are listed but not counted.
_UUA_UPTODATE=0
_UUA_UPDATED=0
_UUA_AVAILABLE=0
_UUA_FAILED_STEPS=0

# Notes printed after the summary
_UUA_NODE_CHANGED=0
_UUA_REBOOT=0

# Run state
_UUA_LOG_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/uua"
_UUA_LOGS_KEPT=10
_UUA_RUN_DIR=""
_UUA_RUN_LOCK="$_UUA_LOG_ROOT/lock"
_UUA_HAVE_RUN_LOCK=0
_UUA_NPM_ROOT=""
_UUA_ACTIVE_NODE=""
_UUA_SUDO_REFRESH_PID=""
_UUA_CHILD_PIDS=()
_UUA_FOLLOW=()
_UUA_INTERRUPTED=0
_UUA_CLEANED=0

# Where the jobs report (see "Reporting from a job"), where prefetched
# answers wait, and the --verbose stream every job's output goes to.
_UUA_JOB=""
_UUA_JOB_DIR=""
_UUA_CACHE=""
_UUA_STREAM=""

# Time limits in seconds: one registry or release query, one install,
# and one AI CLI job from start to finish, so a stalled download cannot
# hang an unattended run. APT has none: dpkg must not be killed halfway
# through, and apt has network timeouts of its own.
_UUA_QUERY_LIMIT=60
_UUA_INSTALL_LIMIT=900
_UUA_WORKER_LIMIT=1200

_UUA_VER_RE='[0-9]+(\.[0-9]+){1,3}([+-][0-9A-Za-z.-]+)?'


# ─────────────────────────────────────────────────────────────
# Colors and output
# ─────────────────────────────────────────────────────────────

# The board's colors per group, for its label and progress bars, plus
# the whole run's bar, failure, and the faint track the bars fill.
typeset -gA _UUA_GC


_init_colors() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]] && (( ! _UUA_NO_COLOR )); then
    C_RESET=$'\033[0m' C_BOLD=$'\033[1m' C_DIM=$'\033[2m'
    C_RED=$'\033[91m' C_GREEN=$'\033[92m' C_YELLOW=$'\033[93m'
    C_BLUE=$'\033[94m' C_MAGENTA=$'\033[95m' C_CYAN=$'\033[96m'

    if [[ "$TERM" == *256color* || -n "${COLORTERM:-}" ]]; then
      _UUA_GC=(
        total  $'\033[38;5;45m'   system $'\033[38;5;214m'
        node   $'\033[38;5;77m'   bun    $'\033[38;5;211m'
        ai     $'\033[38;5;141m'  failed $'\033[38;5;203m'
        track  $'\033[38;5;240m'
      )
    else
      _UUA_GC=(
        total  $'\033[96m'  system $'\033[93m'  node  $'\033[92m'
        bun    $'\033[95m'  ai     $'\033[94m'  failed $'\033[91m'
        track  $'\033[90m'
      )
    fi
  else
    C_RESET="" C_BOLD="" C_DIM=""
    C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_MAGENTA="" C_CYAN=""
    _UUA_GC=()
  fi
}


# The mark for each state a row or a sub-line can be in.
typeset -gA _UUA_ICON=(
  ok        ✓
  updated   ↑
  available ↑
  failed    ✗
  absent    –
  warn      ⚠
  info      →
  note      ·
  tail      │
  wait      ◌
)


_state_color() {
  case "$1" in
    ok)             REPLY=$C_GREEN ;;
    updated)        REPLY=$C_CYAN ;;
    available|warn) REPLY=$C_YELLOW ;;
    failed)         REPLY=$C_RED ;;
    info)           REPLY=$C_BLUE ;;
    run)            REPLY=$C_MAGENTA ;;
    *)              REPLY=$C_DIM ;;
  esac
}


# "mark  text" for state $1, into REPLY: how a finished job prints when
# there is no board, and how sub-lines print under a row.
_fmt_line() {
  _state_color "$1"

  case "$1" in
    absent|note|tail) REPLY="$C_DIM$_UUA_ICON[$1] $2$C_RESET" ;;
    *)                REPLY="$REPLY$_UUA_ICON[$1]$C_RESET $2" ;;
  esac
}


# Lines the main shell prints outside the board.
_line()   { printf '%s%s%s  %s\n' "$1" "$2" "$C_RESET" "$3" }
_warn()   { _line "$C_YELLOW" "⚠" "$1" }
_fail()   { _line "$C_RED" "✗" "$1" }
_info()   { _line "$C_BLUE" "→" "$1" }


# Outcome buckets for the summary.
_mark_uptodate()  { (( ++_UUA_UPTODATE )) }
_mark_updated()   { (( ++_UUA_UPDATED )) }
_mark_available() { (( ++_UUA_AVAILABLE )) }
_mark_failed()    { (( ++_UUA_FAILED_STEPS )) }


# ─────────────────────────────────────────────────────────────
# Reporting from a job
# ─────────────────────────────────────────────────────────────
#
# A job runs in a subshell of its own, so it reports through files in
# _UUA_JOB_DIR that the board reads: its row (one state and text; the
# last one wins), the sub-lines printed under the row once it is done,
# and what it is doing right now. Called outside a job, as the tests do,
# they print instead.

_row() {
  if [[ -z "$_UUA_JOB" ]]; then
    _fmt_line "$1" "$2"
    print -r -- "$REPLY"
    return 0
  fi

  print -r -- "$1|$2" >|"$_UUA_JOB_DIR/$_UUA_JOB.row"
}


_sub() {
  if [[ -z "$_UUA_JOB" ]]; then
    _fmt_line "$1" "$2"
    print -r -- "   $REPLY"
    return 0
  fi

  print -r -- "$1|$2" >>"$_UUA_JOB_DIR/$_UUA_JOB.sub"
}


# The last lines of log $1 and of $1.err, under the row.
_sub_tail() {
  local f line

  # --verbose has already shown all of it.
  (( _UUA_VERBOSE )) && return 0

  for f in "$1" "$1.err"; do
    [[ -s "$f" ]] || continue

    for line in "${(@f)$(tail -n 8 -- "$f")}"; do
      _sub tail "$line"
    done
  done
}


# The share of the job's progress bar its next activities cover: from
# $1 to $2 (0 to 1), eased in over time with a time constant of $3
# seconds (default 3), or, given $4 and $5, counted as the lines of the
# activity's log that start with $4, out of $5. A percentage the command
# prints counts too. The board never lets a bar shrink.
_UUA_PHASE=()

_phase() {
  _UUA_PHASE=("$1" "$2" "${3:-3}" "${4:-}" "${5:-0}")
}


# What the job is doing now ($1), and the log its progress shows up in
# ($2): the board shows the log's latest line beside it. The current
# _phase goes along. The board reads the file while the job runs, and a
# file rewritten in place can be read torn (the new line, then the tail
# of the old one), so the line is written aside and renamed into place.
_activity() {
  local f="$_UUA_JOB_DIR/$_UUA_JOB.act"

  [[ -n "$_UUA_JOB" ]] || return 0

  print -r -- "$1"$'\t'"${2:-}"$'\t'"${(pj:\t:)_UUA_PHASE}" >|"$f.tmp" &&
    mv -f -- "$f.tmp" "$f"
}


# Hands variables $@ to the main shell, which sets them before it starts
# the jobs that depend on this one: nvm use changes PATH in the job's
# own subshell only.
_job_export() {
  local name flag

  [[ -n "$_UUA_JOB" ]] || return 0

  for name; do
    (( ${+parameters[$name]} )) || continue

    flag=-g
    [[ "$parameters[$name]" == *export* ]] && flag=-gx
    print -r -- "typeset $flag $name=${(qP)name}" >>"$_UUA_JOB_DIR/$_UUA_JOB.env"
  done
}


# Reports a failed step, with the tail of its log when there is one.
_step_error() {
  _row failed "$1"
  [[ -n "${2:-}" ]] && _sub_tail "$2"
  _mark_failed

  return 1
}


# ─────────────────────────────────────────────────────────────
# Processes
# ─────────────────────────────────────────────────────────────

_tick() {
  if (( _UUA_ZSELECT )); then
    zselect -t 8 2>/dev/null
  else
    sleep 0.08
  fi

  return 0
}


_forget_child() {
  _UUA_CHILD_PIDS=(${_UUA_CHILD_PIDS:#$1})
}


# True while $1 is still a child of this shell. A child that exited and
# was reaped may have its pid reused by an unrelated process, which must
# not be signalled in its place.
_is_my_child() {
  local stat

  [[ -r "/proc/$1/stat" ]] || return 1
  stat="$(<"/proc/$1/stat")"

  # The command name (field 2) can hold spaces; the parent pid is the
  # second field after its closing parenthesis.
  stat="${stat##*) }"
  [[ "${${(s: :)stat}[2]}" == "$$" ]]
}


# The pids of $1's children.
_children() {
  local -a files
  local f

  reply=()
  files=(/proc/$1/task/*/children(N))

  if (( $#files )); then
    for f in $files; do
      reply+=($(<$f))
    done
  else
    reply=(${(f)"$(pgrep -P "$1" 2>/dev/null)"})
  fi
}


# Terminates $1 and everything it started. The whole tree is stopped
# before anything is signalled, so no process can fork past the walk or
# be reparented out of it when its parent dies first. Background jobs
# ignore SIGINT, so without this a Ctrl-C would leave npm or curl
# running (and writing) after uua has exited.
_kill_tree() {
  local -a tree queue
  local pid n i

  queue=($1)

  while (( $#queue )); do
    pid=$queue[1]
    shift queue

    kill -STOP "$pid" 2>/dev/null || continue
    tree+=($pid)

    _children "$pid"
    queue+=($reply)
  done

  (( $#tree )) || return 0

  kill -TERM $tree 2>/dev/null
  kill -CONT $tree 2>/dev/null

  # A moment to exit cleanly before it is forced. (wait cannot tell:
  # it returns as soon as a job is stopped.)
  for i in {1..25}; do
    n=0

    for pid in $tree; do
      kill -0 "$pid" 2>/dev/null && (( n++ ))
    done

    (( n )) || return 0
    _tick
  done

  kill -KILL $tree 2>/dev/null

  return 0
}


# Sends signal $1 to $2 and everything it started, stopping and killing
# nothing: APT gets the Ctrl-C it would get in the foreground, which it
# ignores while dpkg runs. Root's processes refuse it; sudo relays it.
_signal_tree() {
  local -a queue
  local pid

  queue=($2)

  while (( $#queue )); do
    pid=$queue[1]
    shift queue

    kill -"$1" "$pid" 2>/dev/null

    _children "$pid"
    queue+=($reply)
  done
}


# Runs "$@" with its output passing through, stopping it (and everything
# it started) after $1 seconds and returning 124 then, as timeout(1)
# does. Unlike timeout(1) it runs shell functions: nvm is one.
_limited() {
  local limit="$1"
  local pid deadline rc

  shift

  "$@" </dev/null &
  pid=$!
  _UUA_CHILD_PIDS+=($pid)
  deadline=$(( EPOCHSECONDS + limit ))

  while kill -0 "$pid" 2>/dev/null; do
    if (( EPOCHSECONDS >= deadline )); then
      _kill_tree "$pid"
      wait "$pid" 2>/dev/null
      _forget_child "$pid"
      return 124
    fi

    _tick
  done

  wait "$pid"
  rc=$?
  _forget_child "$pid"

  return "$rc"
}


# ─────────────────────────────────────────────────────────────
# Running commands
# ─────────────────────────────────────────────────────────────

# --verbose output: each line indented, dimmed and prefixed with the
# name of the log it comes from, "[npm-install]". tail's "==> file <=="
# headers switch the name when it follows several logs; name is the
# default. Blank lines are dropped (tail puts one before each header),
# and fflush keeps mawk from holding the lines back until the end.
_UUA_VERBOSE_AWK='
  /^==> .* <==$/ {
    name = $0
    sub(/^==> /, "", name)
    sub(/ <==$/, "", name)
    sub(/.*\//, "", name)
    sub(/\.log(\.err)?$/, "", name)
    next
  }

  /^$/ { next }

  {
    printf "   %s[%s] %s%s\n", dim, name, $0, reset
    fflush()
  }
'


# Filters files $2... (or stdin) into the --verbose stream, or to stdout
# where there is none (the tests), naming the lines $1 until a header
# says otherwise.
_verbose_filter() {
  if [[ -n "$_UUA_STREAM" ]]; then
    awk -v name="$1" -v dim="$C_DIM" -v reset="$C_RESET" "$_UUA_VERBOSE_AWK" "${@:2}" >>"$_UUA_STREAM"
  else
    awk -v name="$1" -v dim="$C_DIM" -v reset="$C_RESET" "$_UUA_VERBOSE_AWK" "${@:2}"
  fi
}


# Streams logs $@ as they grow, until _follow_stop. -F picks up logs
# that do not exist yet; tail exits once the sentinel is gone, after
# printing what is left, so nothing is cut off.
_follow_start() {
  local name="${1:t}"

  name="${name%.log}"

  sleep infinity &
  _UUA_FOLLOW=($!)

  tail -n +1 -F -s 0.1 --pid="$_UUA_FOLLOW[1]" -- "$@" 2>/dev/null |
    _verbose_filter "$name" &
  _UUA_FOLLOW+=($!)

  _UUA_CHILD_PIDS+=($_UUA_FOLLOW)
}


_follow_stop() {
  local pid

  (( $#_UUA_FOLLOW )) || return 0

  kill "$_UUA_FOLLOW[1]" 2>/dev/null

  for pid in $_UUA_FOLLOW; do
    wait "$pid" 2>/dev/null
    _forget_child "$pid"
  done

  _UUA_FOLLOW=()
}


# Runs "$@" in this shell (nvm use has to change its PATH), appending its
# output to log $1; --verbose streams the output too, once it is done.
_run_logged() {
  local log="$1"
  local rc name="${${1:t}%.log}"

  shift

  "$@" >"$log.part" 2>&1
  rc=$?

  cat -- "$log.part" >>"$log"
  (( _UUA_VERBOSE )) && _verbose_filter "$name" "$log.part"
  rm -f -- "$log.part"

  return "$rc"
}


# Runs "$@" as the job's activity $1, with stdout in $2 and stderr in
# $2.err (under --verbose both stream as well). The two stay apart so a
# warning cannot be parsed as the version a caller greps out of stdout.
#
# With a time limit ($3 seconds) the command runs in the background and
# is stopped, with everything it started, when the limit passes; 124 is
# returned then, as timeout(1) does. With 0 it runs to the end: that is
# how APT runs, since dpkg is root's and must not be cut off by a timer.
_run_task() {
  local label="$1"
  local logfile="$2"
  local limit="$3"
  local pid="" rc="" waited deadline

  shift 3

  # After Ctrl-C nothing new starts. APT, left to finish what it is
  # running, ends its job here, and the board reports it interrupted.
  if [[ -n "$_UUA_JOB" && -e "$_UUA_JOB_DIR/.stop" ]]; then
    _sub note "not started: $label"
    exit 130
  fi

  _activity "$label" "$logfile"

  : >"$logfile"
  : >"$logfile.err"
  (( _UUA_VERBOSE )) && _follow_start "$logfile" "$logfile.err"

  if (( limit == 0 )); then
    "$@" </dev/null >"$logfile" 2>"$logfile.err"
    rc=$?
  else
    "$@" </dev/null >"$logfile" 2>"$logfile.err" &
    pid=$!
    _UUA_CHILD_PIDS+=($pid)
    deadline=$(( EPOCHSECONDS + limit ))

    while kill -0 "$pid" 2>/dev/null; do
      if (( EPOCHSECONDS >= deadline )); then
        _kill_tree "$pid"
        print -r -- "uua: stopped after ${limit}s without finishing" >>"$logfile.err"
        rc=124
        break
      fi

      _tick
    done

    wait "$pid" 2>/dev/null
    waited=$?
    [[ "$rc" == 124 ]] || rc=$waited
    _forget_child "$pid"
  fi

  _follow_stop

  return "$rc"
}


# ─────────────────────────────────────────────────────────────
# Versions
# ─────────────────────────────────────────────────────────────

_uua_ver() {
  "$@" 2>/dev/null |
    grep -Eo "$_UUA_VER_RE" |
    head -n 1
}


_strip_v() {
  print -r -- "${1#v}"
}


# True only when $2 is a genuinely newer release than $1.
#
# A prerelease as the "latest" target is refused outright: npm's latest
# dist-tag occasionally points at one, it would downgrade a stable
# install, and is-at-least cannot order prerelease suffixes anyway. An
# installed prerelease does move on to its own final release, which
# semver ranks above it. Build metadata ("+...") is ignored, as semver
# says.
_ver_needs_update() {
  local current="${1%%+*}"
  local latest="${2%%+*}"

  [[ -n "$current" && -n "$latest" && "$current" != "$latest" ]] || return 1
  [[ "$latest" == *-* ]] && return 1

  if [[ "$current" == *-* ]]; then
    current="${current%%-*}"
    [[ "$current" == "$latest" ]] && return 0
  fi

  ! is-at-least "$latest" "$current"
}


# Reports the job's tool as up to date or, in --check mode, as
# updatable. True only when the caller should go on to install $2 over
# $1.
_needs_install() {
  local current="$1"
  local latest="$2"

  if ! _ver_needs_update "$current" "$latest"; then
    _row ok "$current · up to date"
    _mark_uptodate
    return 1
  fi

  if (( _UUA_CHECK_ONLY )); then
    _row available "$current → $latest · update available"
    _mark_available
    return 1
  fi

  return 0
}


# Reports an install that took the job's tool from $1 to $2. An
# installer that exits 0 without moving the version (a channel lagging
# the registry, say) is a failure, not an upgrade.
_finish_upgrade() {
  local current="$1"
  local after="$2"
  local note="$3"
  local log="$4"

  if [[ -z "$after" ]]; then
    _step_error "not runnable after the update" "$log"
    return
  fi

  if [[ "$after" == "$current" ]]; then
    _step_error "update finished but the version is still $current" "$log"
    return
  fi

  _row updated "$current → $after · upgraded${note:+, $note}"
  _mark_updated
}


_npm_latest() {
  [[ -n "$1" ]] || return 1

  timeout "$_UUA_QUERY_LIMIT" npm view "$1" version --silent 2>/dev/null |
    head -n 1
}


# Codex installs from its own release channel rather than from npm,
# so its version comes from that channel: the npm publish can lag it.
_codex_latest() {
  command -v curl >/dev/null 2>&1 || return 1

  curl -fsSL --max-time 20 --retry 2 \
    https://releases.openai.com/codex/channels/latest 2>/dev/null |
    grep -Eo '"tag_name"[[:space:]]*:[[:space:]]*"rust-v[^"]+"' |
    grep -Eo "$_UUA_VER_RE" |
    head -n 1
}


# The latest Bun release, from where GitHub's "latest" link redirects.
_bun_latest() {
  local tag

  command -v curl >/dev/null 2>&1 || return 1

  tag="$(
    curl -fsSL --max-time 20 --retry 2 -o /dev/null -w '%{url_effective}' \
      https://github.com/oven-sh/bun/releases/latest 2>/dev/null |
      grep -Eo 'bun-v[0-9]+(\.[0-9]+){1,3}' |
      tail -n 1
  )"

  [[ -n "$tag" ]] && print -r -- "${tag#bun-v}"
}


# The latest LTS release, read straight from the index nvm reads (at the
# mirror nvm would use): nvm version-remote takes seconds longer to say
# the same. The first row with an LTS name is the newest LTS; nvm is
# the fallback.
_node_lts_remote() {
  local v

  if command -v curl >/dev/null 2>&1; then
    v="$(
      curl -fsSL --max-time 20 --retry 2 \
        "${NVM_NODEJS_ORG_MIRROR:-https://nodejs.org/dist}/index.tab" 2>/dev/null |
        awk -F '\t' 'NR > 1 && $10 != "-" && $10 != "" { print $1; exit }'
    )"

    [[ "$v" == v[0-9]* ]] && { print -r -- "$v"; return 0 }
  fi

  _load_nvm || return 1

  nvm version-remote 'lts/*'
}


# The latest release for a version source: "npm:<package>" or the name
# of a function that prints it.
_latest_version() {
  [[ -n "$1" ]] || return 1

  if [[ "$1" == npm:* ]]; then
    _npm_latest "${1#npm:}"
  else
    ${=1}
  fi
}


# ─────────────────────────────────────────────────────────────
# Prefetched queries
# ─────────────────────────────────────────────────────────────
#
# The registry and release queries depend on nothing local, so they all
# go out together before the sudo prompt, and each job reads its answer
# when it gets there instead of asking in turn.

# Runs "$@" in the background under a limit of $2 seconds, keeping its
# output and status for _fetch under key $1. The .run marker, written
# before anything starts, holds how long a reader should wait.
_prefetch() {
  local f="$_UUA_CACHE/$1"
  local limit="$2"

  shift 2

  print -r -- $(( EPOCHSECONDS + limit + 5 )) >"$f.run"

  (
    _limited "$limit" "$@" >"$f.out" 2>/dev/null
    print -r -- $? >"$f.rc"
  ) &

  _UUA_CHILD_PIDS+=($!)
}


# The output of "$@": the answer prefetched under key $1 when there is
# one, waiting for it while it is still out, or else a query made now
# under a limit of $2 seconds.
_fetch() {
  local f="$_UUA_CACHE/$1"
  local limit="$2"
  local deadline

  shift 2

  if [[ -n "$_UUA_CACHE" && -s "$f.run" ]]; then
    deadline="$(<"$f.run")"

    while [[ ! -s "$f.rc" ]] && (( EPOCHSECONDS < deadline )); do
      _tick
    done

    if [[ -s "$f.rc" ]]; then
      [[ -s "$f.out" ]] && print -r -- "$(<"$f.out")"
      return "$(<"$f.rc")"
    fi
  fi

  _limited "$limit" "$@"
}


# ─────────────────────────────────────────────────────────────
# Ownership, use and locks
# ─────────────────────────────────────────────────────────────

# True when a running process executes a file under directory $1: a live
# session still loads files from its own release, so that release must
# not be removed underneath it.
_in_use() {
  local dir="${1:A}"
  local exe

  for exe in /proc/<->/exe(N:A); do
    [[ "$exe" == "$dir"/* ]] && return 0
  done

  return 1
}


_is_npm_managed() {
  local bin

  [[ -n "$_UUA_NPM_ROOT" ]] || return 1

  bin="$(command -v "$1" 2>/dev/null)"
  [[ "$bin" == /* ]] || return 1

  [[ "${bin:A}" == "$_UUA_NPM_ROOT"/* ]]
}


_is_bun_managed() {
  local bin

  bin="$(command -v "$1" 2>/dev/null)"
  [[ "$bin" == /* ]] || return 1

  [[ "${bin:A}" == "$(_bun_global_root)"/* ]]
}


# dpkg is asked only about files outside $HOME, where it never installs.
_is_apt_managed() {
  local bin

  command -v dpkg-query >/dev/null 2>&1 || return 1

  bin="$(command -v "$1" 2>/dev/null)"
  [[ "$bin" == /* && "${bin:A}" != "$HOME"/* ]] || return 1

  dpkg-query -S "${bin:A}" >/dev/null 2>&1
}


# Which package manager installed command $1, into REPLY: apt, npm or
# bun, "native" for an installer of its own, "absent" when it is not
# installed. It decides what the tool's job waits for.
_tool_owner() {
  local bin real

  REPLY=absent
  bin="$(command -v "$1" 2>/dev/null)" || return 0

  REPLY=native
  [[ "$bin" == /* ]] || return 0
  real="${bin:A}"

  if _is_apt_managed "$1"; then
    REPLY=apt
  elif _is_npm_managed "$1" || [[ -n "${NVM_DIR:-}" && "$real" == "$NVM_DIR"/versions/node/* ]]; then
    REPLY=npm
  elif _is_bun_managed "$1"; then
    REPLY=bun
  fi
}


# The npm step resolves this, but a filtered run (--ai alone) skips it
# while the CLI jobs still need it to recognize npm-managed executables.
_resolve_npm_root() {
  [[ -n "$_UUA_NPM_ROOT" ]] && return 0
  command -v npm >/dev/null 2>&1 || return 0

  _UUA_NPM_ROOT="$(npm root -g 2>/dev/null)"

  return 0
}


# Runs "$@" under the lock of global package tree $1 (npm or bun), which
# the jobs sharing that tree take to write it; "-s" after the name takes
# it shared, to read the tree while nothing writes it. -o keeps the
# lock's descriptor out of the command and anything it leaves running.
_with_lock() {
  local lock="$_UUA_LOG_ROOT/$1.lock"

  shift

  if [[ "$1" == -s ]]; then
    shift
    flock -s -o "$lock" "$@"
  else
    flock -o "$lock" "$@"
  fi
}


# One updating run at a time: two would install Node, upgrade Bun or
# prune releases underneath each other. The lock is a directory holding
# the owner's pid, so a lock left by a killed run can be reclaimed; the
# check-and-take happens under a brief flock so two runs cannot both
# reclaim it. (A flock held for the whole run would be inherited by any
# daemon an updater starts, and outlive the run.) Sets REPLY to the
# owner's pid when the lock is held.
_acquire_run_lock() {
  REPLY="$(
    flock "$_UUA_RUN_LOCK.guard" sh -c '
      if ! mkdir -m 700 "$1" 2>/dev/null; then
        owner=$(cat "$1/pid" 2>/dev/null)

        if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
          echo "$owner"
          exit 1
        fi

        rm -rf -- "$1" && mkdir -m 700 "$1" || { echo "?"; exit 1; }
      fi

      echo "$2" >"$1/pid"
    ' sh "$_UUA_RUN_LOCK" "$$"
  )" || return 1

  _UUA_HAVE_RUN_LOCK=1
}


_release_run_lock() {
  (( _UUA_HAVE_RUN_LOCK )) || return 0

  rm -rf -- "$_UUA_RUN_LOCK"
  _UUA_HAVE_RUN_LOCK=0
}


# ─────────────────────────────────────────────────────────────
# Global packages
# ─────────────────────────────────────────────────────────────

# "name version" for each global npm package installed from a registry.
# Links (npm link), local directories and git checkouts are left out:
# "updating" one would replace it with the registry release of the same
# name.
_npm_global_packages() {
  _with_lock npm -s npm ls -g --depth=0 --json 2>/dev/null |
    node -e '
      let tree = {};
      try { tree = JSON.parse(require("fs").readFileSync(0, "utf8")); } catch { process.exit(1); }
      for (const [name, dep] of Object.entries(tree.dependencies || {})) {
        if (!dep.version) continue;
        if (dep.resolved && !/^https?:/.test(dep.resolved)) continue;
        console.log(name + " " + dep.version);
      }
    '
}


_bun_global_root() {
  print -r -- "${BUN_INSTALL:-$HOME/.bun}/install/global"
}


# "name version" for each global bun package installed from a registry;
# git, URL, file and link dependencies are left out, as for npm. The
# path goes in through argv, never spliced into the script.
_bun_global_packages() {
  local root="$(_bun_global_root)"
  local js=node

  [[ -f "$root/package.json" ]] || return 1
  command -v node >/dev/null 2>&1 || js=bun

  _with_lock bun -s "$js" -e '
    const fs = require("fs"), path = require("path"), root = process.argv[1];
    const read = (...p) => JSON.parse(fs.readFileSync(path.join(root, ...p), "utf8"));
    for (const [name, spec] of Object.entries(read("package.json").dependencies || {})) {
      if (/[:\/]/.test(spec)) continue;
      try { console.log(name + " " + read("node_modules", name, "package.json").version); } catch {}
    }
  ' "$root"
}


# Packages another job already owns, so the global sweeps leave them
# be. npm and corepack ship with Node and follow its install.
_managed_packages() {
  local row

  for row in $_UUA_TOOLS; do
    _tool_fields "$row"
    [[ "$reply[4]" == npm:* ]] && print -r -- "${reply[4]#npm:}"
  done

  print -rl -- npm corepack
}


# "name version" for each package $@ from the registry, eight lookups at
# a time (one npm process per package, in turn, takes seconds each);
# "name -" for a lookup that failed.
_registry_latest() {
  print -rl -- "$@" |
    xargs -P 8 -n 1 sh -c '
      v=$(timeout "$0" npm view "$1" version --silent 2>/dev/null | head -n 1)
      printf "%s %s\n" "$1" "${v:--}"
    ' "$_UUA_QUERY_LIMIT"
}


# The registry's latest release of each package lister $1 reports,
# except the ones another job owns: what a sweep compares against,
# looked up ahead of it.
_globals_latest() {
  local -a managed names
  local name version

  managed=(${(f)"$(_managed_packages)"})

  while read -r name version; do
    [[ -n "$name" ]] || continue
    (( ${managed[(Ie)$name]} )) && continue

    names+=("$name")
  done < <("$1")

  (( $#names )) && _registry_latest $names

  return 0
}


# Reads "name version" lines and prints "name current latest" for each
# package a newer registry release exists for. The latest releases come
# prefetched under key $1 when given; packages it lacks are looked up.
_outdated_packages() {
  local cache="${1:-}"
  local -a managed names missing
  local -A current latest
  local name version found=0

  managed=(${(f)"$(_managed_packages)"})

  while read -r name version; do
    [[ -n "$name" && -n "$version" ]] || continue
    (( ${managed[(Ie)$name]} )) && continue

    names+=("$name")
    current[$name]="$version"
  done

  (( $#names )) || return 0

  if [[ -n "$cache" ]]; then
    while read -r name version; do
      [[ -n "$name" ]] && latest[$name]="$version"
    done < <(_fetch "$cache" "$_UUA_QUERY_LIMIT" true)
  fi

  for name in $names; do
    (( ${+latest[$name]} )) || missing+=("$name")
  done

  if (( $#missing )); then
    while read -r name version; do
      [[ -n "$name" ]] && latest[$name]="$version"
    done < <(_registry_latest $missing)
  fi

  for name in $names; do
    [[ -n "$latest[$name]" && "$latest[$name]" != - ]] && (( found++ ))
  done

  # Every lookup failing means the registry is unreachable, which must
  # not be reported as "everything is current".
  (( found )) || return 1

  for name in $names; do
    [[ "$latest[$name]" == - ]] && continue

    _ver_needs_update "$current[$name]" "$latest[$name]" &&
      print -r -- "$name $current[$name] $latest[$name]"
  done

  return 0
}


_list_outdated() {
  setopt localoptions pipefail

  "$1" | _outdated_packages "${2:-}"
}


# Prints the names among "name current latest" lines $2 that lister $1
# still reports below their latest release (or no longer reports).
_still_outdated() {
  local lister="$1"
  local outdated="$2"
  local -A now
  local name current latest

  while read -r name current; do
    now[$name]="$current"
  done < <("$lister")

  while read -r name current latest; do
    [[ -n "$name" ]] || continue

    if [[ -z "$now[$name]" ]] || _ver_needs_update "$now[$name]" "$latest"; then
      print -r -- "$name"
    fi
  done <<<"$outdated"
}


# One global sweep: every registry package except those another job
# owns, updated in one install and listed again afterwards, so one the
# installer skipped is reported rather than counted as upgraded. $3 is
# appended to each package name to form the install spec, $4 is the
# prefetch key of the latest releases; the rest is the install command.
_sweep_globals() {
  local label="$1"
  local lister="$2"
  local spec="$3"
  local cache="$4"
  local log="$_UUA_RUN_DIR/${label// /-}"
  local outdated name current latest
  local -a names targets stuck

  shift 4

  _phase 0 0.4 2
  _run_task "checking the registry" "$log-check.log" "$_UUA_INSTALL_LIMIT" \
    _list_outdated "$lister" "$cache" ||
    { _step_error "unable to query the registry" "$log-check.log"; return }

  outdated="$(<"$log-check.log")"

  if [[ -z "$outdated" ]]; then
    _row ok "up to date"
    _mark_uptodate
    return 0
  fi

  while read -r name current latest; do
    names+=("$name")
    targets+=("$name$spec")
  done <<<"$outdated"

  if (( _UUA_CHECK_ONLY )); then
    _row available "$#names update(s) available"

    while read -r name current latest; do
      _sub available "$name $current → $latest"
    done <<<"$outdated"

    _mark_available
    return 0
  fi

  _phase 0.4 0.92 8
  _run_task "updating ${(j:, :)names}" "$log-install.log" "$_UUA_INSTALL_LIMIT" \
    "$@" "${targets[@]}" ||
    { _step_error "update failed" "$log-install.log"; return }

  _phase 0.92 0.98 1
  _activity "verifying the update"
  stuck=(${(f)"$(_still_outdated "$lister" "$outdated")"})

  if (( $#stuck )); then
    _step_error "still outdated after the update: ${(j:, :)stuck}" "$log-install.log"
    return
  fi

  _row updated "$#names package(s) upgraded"

  while read -r name current latest; do
    _sub updated "$name $current → $latest"
  done <<<"$outdated"

  _mark_updated
}


# ─────────────────────────────────────────────────────────────
# sudo
# ─────────────────────────────────────────────────────────────

# Refreshes the cached sudo credentials so a long run cannot lose root
# halfway through. -n never prompts: if the timestamp is gone the loop
# ends quietly and the apt job reports the problem instead of a prompt
# appearing behind the board.
_sudo_keepalive_start() {
  (
    while sudo -n true 2>/dev/null; do
      sleep 60
    done
  ) &

  _UUA_SUDO_REFRESH_PID=$!
}


# Collects the password before the board starts, while the terminal is
# still quiet; cached credentials skip the prompt altogether.
_collect_sudo_password() {
  if ! command -v sudo >/dev/null 2>&1; then
    _warn "sudo: not installed (the apt job will report the problem)"
    return 0
  fi

  if ! sudo -v -p "${C_CYAN}◆${C_RESET} sudo password for %u (for apt): "; then
    _fail "sudo: password collection failed or cancelled"
    _mark_failed
    return 1
  fi

  _sudo_keepalive_start

  return 0
}


# ─────────────────────────────────────────────────────────────
# Job: APT
# ─────────────────────────────────────────────────────────────

# Unattended by construction: a conffile prompt or a needrestart dialog
# would block invisibly behind the board, and sudo -n fails rather than
# prompt. The lock timeout waits out unattended-upgrades instead of
# failing on its lock.
_sudo_apt() {
  sudo -n env \
    DEBIAN_FRONTEND=noninteractive \
    NEEDRESTART_MODE=a \
    apt-get -y \
      -o DPkg::Lock::Timeout=300 \
      -o Dpkg::Options::=--force-confdef \
      -o Dpkg::Options::=--force-confold \
      "$@"
}


# What "apt-get upgrade --with-new-pkgs" would install, simulated. Not
# "apt list --upgradable": that also lists phased updates, which the
# upgrade then defers, so it would promise upgrades that never happen.
_apt_pending() {
  apt-get -s upgrade --with-new-pkgs 2>/dev/null | grep -c '^Inst '
}


_apt_unused() {
  apt-get -s autoremove 2>/dev/null | grep -c '^Remv '
}


# Runs both simulations side by side (they only read), into the
# variables named $1 (upgrades pending) and $2 (packages nothing needs).
_apt_simulate() {
  local tmp="$_UUA_RUN_DIR/apt-simulate"
  local pid

  _apt_pending >"$tmp.pending" &
  pid=$!
  _apt_unused >"$tmp.unused"
  wait "$pid"

  : ${(P)1::=$(<"$tmp.pending")} ${(P)2::=$(<"$tmp.unused")}
}


_apt_prune() {
  local log="$1"
  local unused="${2:-0}"

  (( unused )) || return 0

  if (( ! _UUA_PRUNE || _UUA_CHECK_ONLY )); then
    _sub info "$unused unused package(s); --prune removes them"
    return 0
  fi

  _phase 0.97 0.99 2 "Removing" "$unused"

  if _run_task "removing $unused unused package(s)" "$log" 0 _sudo_apt autoremove; then
    _sub ok "$unused unused package(s) removed"
  else
    _sub warn "autoremove failed"
    _sub_tail "$log"
  fi
}


_step_apt() {
  local log="$_UUA_RUN_DIR/apt"
  local pending left unused=0 note=""

  if ! command -v apt-get >/dev/null 2>&1; then
    _row absent "not available on this system"
    return 0
  fi

  # Check mode neither asks for a password nor rewrites the package
  # lists, so it reports against whatever metadata is already on disk.
  if (( _UUA_CHECK_ONLY )); then
    _phase 0 0.95 1
    _activity "simulating the upgrade"
    _apt_simulate pending unused

    if (( pending )); then
      _row available "$pending update(s) available · metadata not refreshed"
      _mark_available
    else
      _row ok "up to date · metadata not refreshed"
      _mark_uptodate
    fi

    _apt_prune "" "$unused"
    [[ -f /var/run/reboot-required ]] && _UUA_REBOOT=1

    return 0
  fi

  command -v sudo >/dev/null 2>&1 ||
    { _step_error "sudo not installed"; return }

  # The password was collected up front; credentials that expired since
  # then are a failure rather than an invisible prompt.
  sudo -n true 2>/dev/null ||
    { _step_error "sudo credentials expired (re-run uua)"; return }

  _phase 0 0.3 4
  _run_task "refreshing package metadata" "$log-update.log" 0 _sudo_apt update ||
    { _step_error "repository refresh failed" "$log-update.log"; return }

  _phase 0.3 0.35 1
  _activity "resolving upgrades"
  pending="$(_apt_pending)"

  if (( pending == 0 )); then
    _phase 0.35 0.95 1
    _activity "looking for unused packages"
    unused="$(_apt_unused)"

    _row ok "up to date"
    _mark_uptodate
  else
    # dpkg prints "Setting up" once for each package it has installed.
    _phase 0.35 0.95 10 "Setting up" "$pending"
    _run_task "installing $pending update(s)" "$log-upgrade.log" 0 \
      _sudo_apt upgrade --with-new-pkgs ||
      { _step_error "upgrade failed" "$log-upgrade.log"; return }

    _phase 0.95 0.97 1
    _activity "verifying the upgrade"
    _apt_simulate left unused

    if (( left >= pending )); then
      _step_error "upgrade finished but $left package(s) are still pending" "$log-upgrade.log"
      return
    fi

    (( left )) && note=", $left still pending"

    _row updated "$(( pending - left )) package(s) upgraded$note"
    _mark_updated
  fi

  _apt_prune "$log-autoremove.log" "$unused"
  [[ -f /var/run/reboot-required ]] && _UUA_REBOOT=1

  return 0
}


# ─────────────────────────────────────────────────────────────
# Job: Node.js / nvm
# ─────────────────────────────────────────────────────────────

_load_nvm() {
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

  command -v nvm >/dev/null 2>&1 && return 0

  [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"

  command -v nvm >/dev/null 2>&1
}


# The local version nvm resolves $1 to, without the "v"; nothing when
# there is none.
_nvm_ver() {
  local v

  v="$(nvm version "$1" 2>/dev/null)"
  [[ "$v" == v[0-9]* ]] && print -r -- "${v#v}"

  return 0
}


# Installed versions older than $1, except $2 (the default's): what
# --prune removes. Newer installs, a Current release say, are not old
# relative to the LTS and may be intentional.
_nvm_stale_versions() {
  local target="$1"
  local keep="$2"
  local dir v

  for dir in "$NVM_DIR/versions/node"/v[0-9]*(N/); do
    v="${${dir:t}#v}"
    [[ "$v" == "$target" || "$v" == "$keep" ]] && continue

    is-at-least "$target" "$v" || print -r -- "$v"
  done
}


# The text of the default alias ("lts/*", "22", "v22.20.0", "system"),
# or nothing when it is unset. The text, not the version it resolves
# to: "22" and "v22.20.0" resolve alike today but pin differently.
_nvm_default_alias() {
  [[ -r "$NVM_DIR/alias/default" ]] && print -r -- "$(<"$NVM_DIR/alias/default")"

  return 0
}


# True when the default alias $1 should move to lts/*: it is unset,
# points at nothing installed, or names the very release this run
# replaced ($2, empty when nothing was replaced). "lts/*" follows
# already; anything else ("22", "lts/iron", "system", another release)
# is a pin and stays.
_default_should_follow() {
  local alias_target="$1"
  local replaced="$2"

  [[ -z "$alias_target" ]] && return 0
  [[ "$alias_target" == 'lts/*' || "$alias_target" == system ]] && return 1
  [[ -z "$(_nvm_ver default)" ]] && return 0

  [[ -n "$replaced" && "${alias_target#v}" == "$replaced" ]]
}


# The jobs update the installation new shells get, the nvm default,
# rather than whatever the invoking shell has active (an .nvmrc, say);
# "uua" and "uua --ai" then update the same one.
_use_default_node() {
  _load_nvm || return 0
  [[ -n "$(_nvm_default_alias)" ]] || return 0

  nvm use default >/dev/null 2>&1 && rehash 2>/dev/null

  return 0
}


# Global packages still to be moved into a new LTS, as "<new> <old>":
# written before nvm install copies them over and removed once it has,
# so a run cut off halfway is finished by the next one rather than
# leaving the new LTS without them.
_UUA_NODE_PENDING="$_UUA_LOG_ROOT/node-packages-pending"


# The Node the jobs after this one use, handed to the main shell.
_export_node() {
  rehash 2>/dev/null
  _job_export PATH NVM_BIN NVM_INC MANPATH
}


_step_node() {
  local log="$_UUA_RUN_DIR/node"
  local active="$_UUA_ACTIVE_NODE"
  local installed latest target after from replaced="" pinned=""
  local alias_target default note
  local upgraded=0
  local -a install_args stale notes pending

  if ! _load_nvm; then
    _row absent "nvm not installed"
    return 0
  fi

  alias_target="$(_nvm_default_alias)"

  # Compare the newest locally installed LTS rather than the active
  # version; an old .nvmrc must not keep the LTS from advancing.
  installed="$(_nvm_ver 'lts/*')"

  _phase 0 0.15 1
  _activity "checking the latest LTS"

  _fetch node-lts "$_UUA_QUERY_LIMIT" _node_lts_remote >"$log-remote.log" 2>&1 ||
    { _step_error "unable to query the latest LTS" "$log-remote.log"; return }

  latest="$(grep -Eo '[0-9]+(\.[0-9]+){2}' "$log-remote.log" | tail -n 1)"

  [[ -n "$latest" ]] ||
    { _step_error "unable to detect the latest LTS version" "$log-remote.log"; return }

  if [[ -n "$installed" ]] && ! _ver_needs_update "$installed" "$latest"; then
    target="$installed"

    if (( _UUA_CHECK_ONLY )); then
      if [[ "$active" == "$installed" ]]; then
        _row ok "$installed · latest LTS"
      else
        _row ok "LTS $installed · active: ${active:-none}"
        _sub info "Node LTS $installed is not active; switch with: nvm use lts/*"
      fi

      [[ -r "$_UUA_NODE_PENDING" ]] &&
        _sub warn "an earlier run did not finish moving global packages to $installed; run uua to finish"

      _mark_uptodate
      return 0
    fi
  else
    if (( _UUA_CHECK_ONLY )); then
      _row available "${installed:-none} → $latest · update available"
      _mark_available
      return 0
    fi

    install_args=(nvm install --latest-npm)

    if [[ "$active" == [0-9]* ]]; then
      from="$active"
    else
      from="$installed"
    fi

    if [[ -n "$from" ]]; then
      install_args+=(--reinstall-packages-from="$from")
      print -r -- "$latest $from" >"$_UUA_NODE_PENDING"
    fi

    # nvm install runs in the background (for its time limit), so its
    # own switch to the new version is lost; nvm use below makes it.
    _phase 0.15 0.85 8
    _run_task "installing Node.js $latest" "$log-install.log" "$_UUA_INSTALL_LIMIT" \
      $install_args 'lts/*' ||
      { _step_error "install of $latest failed" "$log-install.log"; return }

    rm -f -- "$_UUA_NODE_PENDING"

    target="$latest"
    replaced="$installed"
    upgraded=1
  fi

  _phase 0.85 0.9 1
  _activity "activating $target"

  _run_logged "$log-use.log" nvm use "$target" ||
    { _step_error "unable to activate $target" "$log-use.log"; return }

  _export_node
  after="$(_uua_ver node --version)"

  [[ "$after" == "$target" ]] ||
    { _step_error "$target installed but node reports ${after:-nothing}" "$log-use.log"; return }

  # A run cut off during the install left the new LTS without the global
  # packages it was to get; nvm use above made it current for them.
  if [[ -r "$_UUA_NODE_PENDING" ]]; then
    pending=(${=$(<"$_UUA_NODE_PENDING")})

    if [[ "$pending[1]" == "$target" && -d "$NVM_DIR/versions/node/v$pending[2]" ]]; then
      _phase 0.9 0.97 8
      _run_task "reinstalling global packages from $pending[2]" "$log-reinstall.log" \
        "$_UUA_INSTALL_LIMIT" nvm reinstall-packages "$pending[2]" ||
        { _step_error "unable to reinstall the global packages from $pending[2]" "$log-reinstall.log"; return }

      notes+=("global packages from $pending[2] reinstalled")
    fi

    rm -f -- "$_UUA_NODE_PENDING"
  fi

  if [[ "$alias_target" != 'lts/*' ]]; then
    if _default_should_follow "$alias_target" "$replaced"; then
      _run_logged "$log-use.log" nvm alias default 'lts/*' ||
        { _step_error "unable to point the default alias at lts/*" "$log-use.log"; return }

      notes+=("default now follows lts/*")
    else
      pinned="$alias_target"
      notes+=("default pinned to $pinned")
    fi
  fi

  # The later jobs update the Node new shells get: this LTS, or the
  # release the default is pinned to.
  if [[ -n "$pinned" ]]; then
    _run_logged "$log-use.log" nvm use default ||
      { _step_error "unable to switch to the default ($pinned)" "$log-use.log"; return }

    _export_node
  fi

  default="$(_nvm_ver default)"
  stale=(${(f)"$(_nvm_stale_versions "$target" "$default")"})

  if (( $#stale && _UUA_PRUNE )); then
    # Removed by the prune job once every other job has finished, so
    # none of them loses the Node it runs on.
    print -rl -- $stale >"$_UUA_RUN_DIR/node-stale"
  elif (( $#stale )); then
    notes+=("$#stale older release(s) kept, --prune removes them")
  fi

  # A standalone CLI cannot change its parent shell's PATH; new shells
  # get the default, and this one needs a refresh.
  [[ -z "$pinned" && "$active" != "$target" ]] && _UUA_NODE_CHANGED=1

  if (( upgraded )); then
    _row updated "${installed:-none} → $target · upgraded"
    _mark_updated
  else
    _row ok "$target · latest LTS"
    _mark_uptodate
  fi

  for note in $notes; do
    _sub note "$note"
  done

  return 0
}


# Removes the old releases the node job listed: last of all, when no
# job can still be running one. nvm uninstall also cleans up aliases;
# it refuses the active version, which the node job moved off these.
_step_node_prune() {
  local log="$_UUA_RUN_DIR/node-prune.log"
  local list="$_UUA_RUN_DIR/node-stale"
  local v removed=0 busy=0 failed=0

  if [[ ! -s "$list" ]] || ! _load_nvm; then
    _row ok "no old Node.js releases"
    return 0
  fi

  _phase 0 0.95 2

  for v in ${(f)"$(<"$list")"}; do
    _activity "removing Node.js $v"

    if _in_use "$NVM_DIR/versions/node/v$v"; then
      (( busy++ ))
    elif _run_logged "$log" nvm uninstall "$v"; then
      (( removed++ ))
      [[ "$v" == "$_UUA_ACTIVE_NODE" ]] && _UUA_NODE_CHANGED=1
    else
      (( failed++ ))
    fi
  done

  (( failed )) &&
    { _step_error "unable to remove $failed old release(s)" "$log"; return }

  if (( busy )); then
    _row ok "$removed old release(s) removed, $busy in use and kept"
  else
    _row ok "$removed old release(s) removed"
  fi
}


# ─────────────────────────────────────────────────────────────
# Job: npm
# ─────────────────────────────────────────────────────────────

_step_npm() {
  local log="$_UUA_RUN_DIR/npm"
  local current latest note=""

  if ! command -v npm >/dev/null 2>&1; then
    _row absent "not installed"
    return 0
  fi

  # Resolved before the registry query: if a lookup failure left this
  # empty, npm-managed CLIs would self-update outside the global lock.
  _UUA_NPM_ROOT="$(npm root -g 2>/dev/null)"
  _job_export _UUA_NPM_ROOT

  current="$(npm --version 2>/dev/null)"

  _phase 0 0.3 1
  _activity "checking the latest npm"
  latest="$(_fetch npm-latest "$_UUA_QUERY_LIMIT" _npm_latest npm)"
  [[ "$latest" =~ $_UUA_VER_RE ]] && latest="$MATCH" || latest=""

  [[ -n "$latest" ]] ||
    { _step_error "unable to query the registry"; return }

  [[ -n "$current" ]] ||
    { _step_error "unable to detect the installed version"; return }

  _needs_install "$current" "$latest" || return 0

  _phase 0.3 0.95 6

  if ! _run_task "updating to $latest" "$log-install.log" "$_UUA_INSTALL_LIMIT" \
    _with_lock npm npm install -g npm@latest
  then
    # npm@latest can require a newer Node than the active one.
    command -v nvm >/dev/null 2>&1 ||
      { _step_error "update failed" "$log-install.log"; return }

    _sub warn "npm@latest rejected; trying the latest compatible version"

    _run_task "installing the latest compatible npm" "$log-compat.log" "$_UUA_INSTALL_LIMIT" \
      nvm install-latest-npm ||
      { _step_error "update failed" "$log-compat.log"; return }

    note="latest compatible"
  fi

  rehash 2>/dev/null
  _finish_upgrade "$current" "$(npm --version 2>/dev/null)" "$note" "$log-install.log"
}


# ─────────────────────────────────────────────────────────────
# Job: Bun
# ─────────────────────────────────────────────────────────────

_step_bun() {
  local log="$_UUA_RUN_DIR/bun"
  local current latest

  if ! command -v bun >/dev/null 2>&1; then
    _row absent "not installed"
    return 0
  fi

  command -v curl >/dev/null 2>&1 ||
    { _step_error "curl is needed to check for releases"; return }

  current="$(_uua_ver bun --version)"

  _phase 0 0.3 1
  _activity "checking the latest release"
  latest="$(_fetch bun-latest "$_UUA_QUERY_LIMIT" _bun_latest)"

  [[ -n "$current" && -n "$latest" ]] ||
    { _step_error "unable to detect the version"; return }

  _needs_install "$current" "$latest" || return 0

  _phase 0.3 0.95 5
  _run_task "updating to $latest" "$log-install.log" "$_UUA_INSTALL_LIMIT" bun upgrade ||
    { _step_error "update failed" "$log-install.log"; return }

  rehash 2>/dev/null
  _finish_upgrade "$current" "$(_uua_ver bun --version)" "" "$log-install.log"
}


# ─────────────────────────────────────────────────────────────
# Jobs: global packages
# ─────────────────────────────────────────────────────────────

_step_npm_globals() {
  if ! command -v npm >/dev/null 2>&1; then
    _row absent "npm not installed"
    return 0
  fi

  _sweep_globals "npm globals" _npm_global_packages "@latest" npm-g-latest \
    _with_lock npm npm install -g
}


_step_bun_globals() {
  if ! command -v bun >/dev/null 2>&1; then
    _row absent "bun not installed"
    return 0
  fi

  if [[ ! -f "$(_bun_global_root)/package.json" ]]; then
    _row absent "none installed"
    return 0
  fi

  _sweep_globals "bun globals" _bun_global_packages "" bun-g-latest \
    _with_lock bun bun update --latest -g
}


# ─────────────────────────────────────────────────────────────
# Jobs: AI CLIs
# ─────────────────────────────────────────────────────────────

# OpenCode v2's package ships a launcher that its postinstall replaces
# with the platform binary; a blocked script leaves the launcher
# unusable.
_repair_opencode() {
  local dir

  for dir in \
    "$(_bun_global_root)/node_modules/@opencode/cli" \
    "${_UUA_NPM_ROOT:-}/@opencode/cli"
  do
    [[ -f "$dir/postinstall.mjs" ]] || continue

    node "$dir/postinstall.mjs" && return 0
  done

  return 1
}


# Codex's standalone installer never prunes: every release it unpacks
# stays behind (~320MB each) and only "current" is live. With "count"
# prints how many releases are stale; with "remove" removes the stale
# ones no running process uses and prints how many went.
_codex_prune() {
  local mode="$1"
  local root="${CODEX_HOME:-$HOME/.codex}/packages/standalone"
  local current dir
  local n=0

  [[ -d "$root/releases" ]] || return 0

  current="${root}/current"
  current="${current:A}"

  # Without a resolvable current release every directory looks stale,
  # so leave the whole installation alone.
  [[ -d "$current" && "$current" != "$root/current" ]] || return 0

  for dir in "$root/releases"/*(N/); do
    [[ "${dir:A}" == "$current" ]] && continue
    [[ -f "$dir/codex-package.json" ]] || continue

    if [[ "$mode" == remove ]]; then
      _in_use "$dir" && continue
      rm -rf -- "$dir" 2>/dev/null || continue
    fi

    (( n++ ))
  done

  (( n )) && print -r -- "$n"

  return 0
}


# key | label | command | version source | update policy | self-updater
#     | extensions updater | repair | prune
#
# The version source is "npm:<package>", which also keeps the global
# sweeps off that package, or a function printing the latest release
# for a tool npm does not publish. Policy "auto" updates through npm
# when npm owns the executable; "self" always uses the self-updater.
# Either way the tool's job waits for the job of the package manager
# that installed it (see _tool_owner), and takes that tree's lock.
#
# The extensions updater refreshes the tool's own extension packages
# (in its own directory, not a global tree, so without a lock). It runs
# whenever the tool is runnable, even when the tool is already current,
# but never in --check mode: there is no dry run.
#
# The repair command reinstates an executable a package manager left
# unrunnable; it runs only when the version cannot be read.
#
# The prune command is called with "count" or, under --prune, "remove",
# for install directories the live one has superseded.
_UUA_TOOLS=(
  'claude|Claude Code|claude|npm:@anthropic-ai/claude-code|auto|claude update|||'
  'codex|Codex|codex|_codex_latest|self|codex update|||_codex_prune'
  'opencode|OpenCode|opencode|npm:@opencode/cli|auto|opencode upgrade||_repair_opencode|'
  'pi|Pi|pi|npm:@earendil-works/pi-coding-agent|self|pi update --self|pi update --extensions||'
)


# Splits a _UUA_TOOLS row into $reply. "(@s:|:)" keeps empty fields in
# place, where read would need care not to shift them.
_tool_fields() {
  reply=("${(@s:|:)1}")
}


# A tool's outcome, "state|current|latest|notes" (notes separated by
# "; "), written under a temporary name and renamed so the reader never
# sees half a line.
_write_result() {
  local file="$_UUA_RUN_DIR/$1.result"

  shift
  print -r -- "${(j:|:)@}" >"$file.tmp" && mv -f -- "$file.tmp" "$file"
}


# Runs the tool's extensions updater ("pi update --extensions") and
# records "updated", "current" or "failed" as a result of its own. Its
# failure is not the tool's.
_extensions_update() {
  local key="$1"
  local log="$_UUA_RUN_DIR/$1-extensions.log"
  local state

  [[ -n "$2" ]] || return 0
  (( _UUA_CHECK_ONLY )) && return 0

  _phase 0.92 0.99 3
  _activity "updating extensions" "$log"

  if ${=2} </dev/null >"$log" 2>&1; then
    # The updater prints progress lines only when a package actually
    # changes; its closing "Updated" banner prints either way.
    if grep -q 'Updating' "$log"; then
      state=updated
    else
      state=current
    fi
  else
    state=failed
  fi

  _write_result "$key-ext" "$state"
}


# Runs a tool's repair command and prints the version it recovered, or
# nothing when there is no repair command, the repair failed, or the run
# is a --check one, which must not modify anything.
_repair_tool() {
  local key="$1"
  local cmd="$2"
  local repair="$3"

  [[ -n "$repair" ]] || return 0
  (( _UUA_CHECK_ONLY )) && return 0

  _phase 0.05 0.1 3
  _activity "repairing the executable" "$_UUA_RUN_DIR/$key-repair.log"
  ${=repair} </dev/null >>"$_UUA_RUN_DIR/$key-repair.log" 2>&1 || return 0

  _uua_ver "$cmd" --version
}


_worker_tool() {
  local key="$1"
  local cmd="$2"
  local version_source="$3"
  local policy="$4"
  local self_updater="$5"
  local extensions="$6"
  local repair="$7"
  local prune="$8"

  local log="$_UUA_RUN_DIR/$key.log"
  local state current latest after n rc
  local runnable=1
  local -a notes updater

  if ! command -v "$cmd" >/dev/null 2>&1; then
    _write_result "$key" absent
    return 0
  fi

  _phase 0 0.1 0.5
  _activity "reading the installed version"

  # An install whose postinstall was blocked is already broken before
  # any update runs, so repair it instead of reporting it unreadable.
  current="$(_uua_ver "$cmd" --version)"

  if [[ -z "$current" ]]; then
    current="$(_repair_tool "$key" "$cmd" "$repair")"
    [[ -n "$current" ]] && notes+=("binary repaired")
  fi

  if [[ -z "$current" ]]; then
    _write_result "$key" failed "" "" "unable to detect the installed version"
    return 0
  fi

  _phase 0.1 0.3 1
  _activity "checking the latest release"

  if _is_apt_managed "$cmd"; then
    # apt owns the executable and has already handled it.
    state=managed
    latest="$current"
    notes+=("managed by apt")

  elif ! latest="$(_fetch "ai-$key" "$_UUA_QUERY_LIMIT" _latest_version "$version_source")" ||
    [[ -z "$latest" ]]
  then
    state=failed
    notes=("unable to detect the latest version")

  elif ! _ver_needs_update "$current" "$latest"; then
    state=ok
    [[ "$current" == "$latest" ]] || notes+=("ahead of $latest")

  elif (( _UUA_CHECK_ONLY )); then
    state=available

  else
    # A "self" tool still takes the lock when a package manager owns it:
    # its own updater writes the same global tree.
    updater=(${=self_updater})

    if _is_npm_managed "$cmd"; then
      if [[ "$policy" == auto && "$version_source" == npm:* ]]; then
        updater=(npm install -g "${version_source#npm:}@latest")
      fi

      updater=(_with_lock npm $updater)
    elif _is_bun_managed "$cmd"; then
      updater=(_with_lock bun $updater)
    fi

    _phase 0.3 0.88 8
    _activity "updating to $latest" "$log"

    "${updater[@]}" </dev/null >"$log" 2>&1
    rc=$?

    rehash 2>/dev/null
    after="$(_uua_ver "$cmd" --version)"

    if (( rc == 0 )) && [[ -z "$after" ]]; then
      after="$(_repair_tool "$key" "$cmd" "$repair")"
      [[ -n "$after" ]] && notes+=("binary repaired")
    fi

    if (( rc != 0 )); then
      state=failed
      notes=("update failed")
      [[ -n "$after" ]] || runnable=0
    elif [[ -z "$after" ]]; then
      state=failed
      notes=("not runnable after the update")
      runnable=0
    elif [[ "$after" == "$current" ]]; then
      # A self-updater following its own release channel can exit 0
      # without moving when that channel lags the registry.
      state=failed
      notes=("updater finished but $cmd is still $current")
    else
      state=updated
      latest="$after"
    fi
  fi

  if [[ -n "$prune" && ( "$state" == ok || "$state" == updated ) ]]; then
    if (( _UUA_PRUNE && ! _UUA_CHECK_ONLY )); then
      _phase 0.88 0.92 1
      _activity "removing old releases"
      n="$(${=prune} remove)"
      [[ -n "$n" ]] && notes+=("$n old release(s) removed")
    else
      n="$(${=prune} count)"
      [[ -n "$n" ]] && notes+=("$n old release(s) kept, --prune removes them")
    fi
  fi

  (( runnable )) && _extensions_update "$key" "$extensions"

  _write_result "$key" "$state" "$current" "$latest" "${(j:; :)notes}"
}


# Turns a tool's result files into its row and sub-lines.
_report_tool() {
  local key="$1"
  local file="$_UUA_RUN_DIR/$key.result"
  local state current latest note
  local -a r notes

  # -s, not -f: a job killed mid-write leaves nothing to read.
  [[ -s "$file" ]] && r=("${(@s:|:)$(<"$file")}")

  state="$r[1]" current="$r[2]" latest="$r[3]"
  notes=(${(s:; :)r[4]})

  case "$state" in
    absent)
      _row absent "not installed"
      ;;

    ok)
      _row ok "$current · up to date"
      _mark_uptodate
      ;;

    managed)
      _row ok "$current · managed by apt"
      notes=(${notes:#managed by apt})
      _mark_uptodate
      ;;

    updated)
      _row updated "$current → $latest · upgraded"
      _mark_updated
      ;;

    available)
      _row available "$current → $latest · update available"
      _mark_available
      ;;

    failed)
      if [[ -n "$current" && -n "$latest" ]]; then
        _row failed "$notes[1] · $current → $latest"
      else
        _row failed "$notes[1]"
      fi

      shift notes
      _mark_failed
      ;;

    "")
      _row failed "no result"
      _mark_failed
      ;;

    *)
      _row failed "unknown state '$state'"
      _mark_failed
      ;;
  esac

  for note in $notes; do
    _sub note "$note"
  done

  if [[ "$state" == failed ]]; then
    _sub_tail "$_UUA_RUN_DIR/$key.log"
    _sub_tail "$_UUA_RUN_DIR/$key-repair.log"
  fi

  file="$_UUA_RUN_DIR/$key-ext.result"
  [[ -s "$file" ]] || return 0

  case "$(<"$file")" in
    updated)
      _sub updated "extensions upgraded"
      _mark_updated
      ;;

    current)
      _sub ok "extensions up to date"
      _mark_uptodate
      ;;

    *)
      _sub failed "extensions update failed"
      _sub_tail "$_UUA_RUN_DIR/$key-extensions.log"
      _mark_failed
      ;;
  esac
}


# The job for tool $1 of _UUA_TOOLS.
_job_ai() {
  local row
  local -a fields

  for row in $_UUA_TOOLS; do
    _tool_fields "$row"
    [[ "$reply[1]" == "$1" ]] && { fields=("${reply[@]}"); break }
  done

  (( $#fields )) || { _step_error "unknown tool $1"; return }

  (( _UUA_VERBOSE )) &&
    _follow_start "$_UUA_RUN_DIR/$1"{.log,-repair.log,-extensions.log}

  _worker_tool "$1" "${(@)fields[3,9]}"
  _follow_stop

  _report_tool "$1"
}


# ─────────────────────────────────────────────────────────────
# Jobs
# ─────────────────────────────────────────────────────────────
#
# The plan is a list of jobs, each with the jobs it waits for. The main
# shell starts every job whose dependencies are done, in a subshell of
# its own, and collects it when it finishes: its outcome counts, and the
# variables it exported for the jobs after it.

typeset -ga _UUA_PLAN
typeset -gA _UUA_J_NAME _UUA_J_GROUP _UUA_J_DEPS _UUA_J_FUNC _UUA_J_LIMIT \
  _UUA_J_OWNER _UUA_J_STATE _UUA_J_PID _UUA_J_START _UUA_J_END _UUA_J_ROW \
  _UUA_J_ACT _UUA_J_LOG _UUA_J_TAIL _UUA_J_TAILAT \
  _UUA_J_PHASE _UUA_J_PHASEAT _UUA_J_FRAC _UUA_J_PROG

_UUA_T0=0
_UUA_T_END=0
_UUA_PLAN_ACTIVE=0
_UUA_STOPPING=0


# Adds job $1 to the plan: shown in group $2 as $3, waiting for the jobs
# in $4 (space-separated), running command $5 under a limit of $6
# seconds (0: none).
_plan_add() {
  _UUA_PLAN+=("$1")
  _UUA_J_GROUP[$1]="$2"
  _UUA_J_NAME[$1]="$3"
  _UUA_J_DEPS[$1]="$4"
  _UUA_J_FUNC[$1]="$5"
  _UUA_J_LIMIT[$1]="${6:-0}"
  _UUA_J_STATE[$1]=wait
}


_plan_build() {
  local row key

  _group_enabled _UUA_WANT_APT &&
    _plan_add apt system apt "" _step_apt 0

  if _group_enabled _UUA_WANT_NODE; then
    _plan_add node node node "" _step_node
    _plan_add npm node npm node _step_npm
    _plan_add npm-g node "npm -g" npm _step_npm_globals

    (( _UUA_PRUNE && ! _UUA_CHECK_ONLY )) &&
      _plan_add prune node prune "" _step_node_prune

    _plan_add bun bun bun "" _step_bun

    # bun -g looks its packages up with npm, which the node job may
    # install or switch.
    _plan_add bun-g bun "bun -g" "bun node" _step_bun_globals
  fi

  if _group_enabled _UUA_WANT_AI; then
    for row in $_UUA_TOOLS; do
      _tool_fields "$row"
      key="ai-$reply[1]"

      _plan_add "$key" ai "$reply[2]" "" "_job_ai $reply[1]" "$_UUA_WORKER_LIMIT"
      _tool_owner "$reply[3]"
      _UUA_J_OWNER[$key]="$REPLY"

      case "$REPLY" in
        apt|npm|bun) _UUA_J_DEPS[$key]="$REPLY" ;;
      esac
    done
  fi

  # Old Node releases go once nothing can be running one.
  (( ${+_UUA_J_NAME[prune]} )) &&
    _UUA_J_DEPS[prune]="${(j: :)${(@)_UUA_PLAN:#prune}}"

  # --check changes nothing, so nothing waits for anything.
  if (( _UUA_CHECK_ONLY )); then
    for key in $_UUA_PLAN; do
      _UUA_J_DEPS[$key]=""
    done
  fi
}


# Sends out the queries of every planned job at once.
_prefetch_all() {
  local row key

  if (( ${+_UUA_J_NAME[node]} )); then
    command -v nvm >/dev/null 2>&1 &&
      _prefetch node-lts "$_UUA_QUERY_LIMIT" _node_lts_remote

    if command -v npm >/dev/null 2>&1; then
      _prefetch npm-latest "$_UUA_QUERY_LIMIT" _npm_latest npm
      _prefetch npm-g-latest "$_UUA_INSTALL_LIMIT" _globals_latest _npm_global_packages

      [[ -f "$(_bun_global_root)/package.json" ]] &&
        _prefetch bun-g-latest "$_UUA_INSTALL_LIMIT" _globals_latest _bun_global_packages
    fi

    command -v bun >/dev/null 2>&1 &&
      _prefetch bun-latest "$_UUA_QUERY_LIMIT" _bun_latest
  fi

  for row in $_UUA_TOOLS; do
    _tool_fields "$row"
    key="ai-$reply[1]"

    (( ${+_UUA_J_NAME[$key]} )) || continue
    [[ "$_UUA_J_OWNER[$key]" == (absent|apt) ]] && continue

    _prefetch "$key" "$_UUA_QUERY_LIMIT" _latest_version "$reply[4]"
  done
}


# A job signalled by anything but the main shell (which stops the whole
# tree itself) takes what it started with it, rather than leave npm or
# curl running without a parent. Not APT: dpkg must not be cut off.
_job_abort() {
  local pid

  _children "$sysparams[pid]"

  for pid in $reply; do
    _kill_tree "$pid"
  done

  exit 143
}


_job_spawn() {
  local key="$1"

  (
    [[ "$key" == apt ]] || trap '_job_abort' TERM HUP

    _UUA_JOB="$key"
    _UUA_UPTODATE=0 _UUA_UPDATED=0 _UUA_AVAILABLE=0 _UUA_FAILED_STEPS=0
    _UUA_NODE_CHANGED=0 _UUA_REBOOT=0
    _UUA_CHILD_PIDS=() _UUA_FOLLOW=() _UUA_PHASE=()

    ${=_UUA_J_FUNC[$key]} >>"$_UUA_JOB_DIR/$key.stray" 2>&1

    print -r -- "$_UUA_UPTODATE $_UUA_UPDATED $_UUA_AVAILABLE $_UUA_FAILED_STEPS" \
      "$_UUA_NODE_CHANGED $_UUA_REBOOT" >"$_UUA_JOB_DIR/$key.counts"
    : >"$_UUA_JOB_DIR/$key.done"
  ) </dev/null &

  _UUA_J_PID[$key]="$!"
  _UUA_J_START[$key]="$EPOCHREALTIME"
  _UUA_J_STATE[$key]=run
  _UUA_CHILD_PIDS+=($!)
}


# Starts every waiting job whose dependencies are done. A dependency
# that is not in the plan (a filtered-out group) counts as done.
_plan_spawn() {
  local key dep ready

  (( _UUA_STOPPING )) && return 0

  for key in $_UUA_PLAN; do
    [[ "$_UUA_J_STATE[$key]" == wait ]] || continue

    ready=1

    for dep in ${=_UUA_J_DEPS[$key]}; do
      if [[ -n "$_UUA_J_STATE[$dep]" && "$_UUA_J_STATE[$dep]" != done ]]; then
        ready=0
        break
      fi
    done

    (( ready )) && _job_spawn "$key"
  done
}


# Collects the jobs that finished and stops those past their limit.
# True when any job finished.
_plan_poll() {
  local key pid limit finished=1

  for key in $_UUA_PLAN; do
    [[ "$_UUA_J_STATE[$key]" == run ]] || continue

    pid="$_UUA_J_PID[$key]"
    limit="$_UUA_J_LIMIT[$key]"

    if [[ -e "$_UUA_JOB_DIR/$key.done" ]] || ! kill -0 "$pid" 2>/dev/null; then
      _job_finish "$key"
      finished=0
    elif (( limit > 0 && EPOCHREALTIME - _UUA_J_START[$key] >= limit )); then
      _is_my_child "$pid" && _kill_tree "$pid"
      _job_finish "$key" "stopped after ${limit}s without finishing"
      finished=0
    fi
  done

  return "$finished"
}


# Collects job $1. A job that ends without its .done marker was stopped
# ($2 says why) or died; its row says so, with the tail of the log it
# was writing.
_job_finish() {
  local key="$1"
  local reason="${2:-}"
  local f="$_UUA_JOB_DIR/$1"
  local act log line
  local -a counts

  wait "$_UUA_J_PID[$key]" 2>/dev/null
  _forget_child "$_UUA_J_PID[$key]"

  _UUA_J_END[$key]="$EPOCHREALTIME"
  _UUA_J_STATE[$key]=done
  _UUA_J_PROG[$key]=1

  if [[ -z "$reason" && -e "$f.done" ]]; then
    counts=(${=$(<"$f.counts")})

    (( _UUA_UPTODATE += counts[1] ))
    (( _UUA_UPDATED += counts[2] ))
    (( _UUA_AVAILABLE += counts[3] ))
    (( _UUA_FAILED_STEPS += counts[4] ))
    (( counts[5] )) && _UUA_NODE_CHANGED=1
    (( counts[6] )) && _UUA_REBOOT=1

    if [[ -s "$f.env" ]]; then
      source "$f.env"
      rehash 2>/dev/null
    fi

    if [[ -s "$f.row" ]]; then
      _UUA_J_ROW[$key]="$(<"$f.row")"
    else
      _UUA_J_ROW[$key]="failed|no result"
      _mark_failed
    fi
  else
    if [[ -z "$reason" ]]; then
      if (( _UUA_STOPPING )); then
        reason="interrupted"
      else
        reason="ended without a result"
      fi
    fi

    _UUA_J_ROW[$key]="failed|$reason"
    (( _UUA_STOPPING )) || _mark_failed

    if (( ! _UUA_VERBOSE )) && [[ -s "$f.act" ]]; then
      act="$(<"$f.act")"
      log="${${(@ps:\t:)act}[2]}"

      if [[ -n "$log" ]]; then
        for line in "${(@f)$(tail -q -n 8 -- "$log" "$log.err" 2>/dev/null)}"; do
          [[ -n "$line" ]] && print -r -- "tail|$line" >>"$f.sub"
        done
      fi
    fi
  fi

  (( _UUA_LIVE )) || _print_job "$key"
}


_plan_all_done() {
  local key

  for key in $_UUA_PLAN; do
    [[ "$_UUA_J_STATE[$key]" == done ]] || return 1
  done
}


# With nothing running, a job still waiting can never start: it waits
# for itself, in a circle. It fails rather than hang the run.
_plan_unstick() {
  local key

  for key in $_UUA_PLAN; do
    [[ "$_UUA_J_STATE[$key]" == run ]] && return 0
  done

  for key in $_UUA_PLAN; do
    [[ "$_UUA_J_STATE[$key]" == wait ]] || continue

    _UUA_J_STATE[$key]=done
    _UUA_J_START[$key]="$EPOCHREALTIME"
    _UUA_J_END[$key]="$EPOCHREALTIME"
    _UUA_J_ROW[$key]="failed|waits for itself: ${_UUA_J_DEPS[$key]}"
    _mark_failed
    (( _UUA_LIVE )) || _print_job "$key"
  done
}


_plan_run() {
  _UUA_PLAN_ACTIVE=1
  _UUA_T0="$EPOCHREALTIME"

  _board_begin

  while true; do
    _plan_spawn

    # A finished job may have freed others: start them without waiting
    # for the next tick.
    while _plan_poll; do
      _plan_spawn
    done

    _plan_all_done && break
    _plan_unstick

    _board_draw
    _tick
  done

  _UUA_T_END="$EPOCHREALTIME"
  _board_end
  _UUA_PLAN_ACTIVE=0
}


# Ctrl-C or a signal: every job is stopped with what it started, except
# APT, which gets the SIGINT it would have got in the foreground (it
# ignores it while dpkg runs) and is waited for. The board shows what
# was cut off.
_plan_stop() {
  local key pid
  local -a killers

  _UUA_STOPPING=1
  : >"$_UUA_JOB_DIR/.stop"

  for key in $_UUA_PLAN; do
    [[ "$_UUA_J_STATE[$key]" == run ]] || continue

    pid="$_UUA_J_PID[$key]"
    _is_my_child "$pid" || continue

    if [[ "$key" == apt ]]; then
      _signal_tree INT "$pid"
    else
      _kill_tree "$pid" &
      killers+=($!)
    fi
  done

  for key in $_UUA_PLAN; do
    if [[ "$_UUA_J_STATE[$key]" == wait ]]; then
      _UUA_J_STATE[$key]=done
      _UUA_J_START[$key]="$EPOCHREALTIME"
      _UUA_J_END[$key]="$EPOCHREALTIME"
      _UUA_J_ROW[$key]="absent|not started"
    fi
  done

  until _plan_all_done; do
    _plan_poll
    _board_draw
    _tick
  done

  (( $#killers )) && wait $killers 2>/dev/null

  _UUA_T_END="$EPOCHREALTIME"
  _board_end
  _UUA_PLAN_ACTIVE=0

  print
}


# ─────────────────────────────────────────────────────────────
# Board
# ─────────────────────────────────────────────────────────────
#
# On a terminal the plan is a live board, redrawn in place a dozen
# times a second: a row per job with its state, what it is doing and the
# latest line of its log, a progress bar in its group's color and its
# time, under a bar for the whole run. The last frame stays, with each
# job's details under its row. Anywhere else each job prints once, when
# it finishes.

_UUA_LIVE=0
_UUA_DRAWN=0
_UUA_TICK=0
_UUA_COLS=80
_UUA_LINES=24
_UUA_STREAM_FD=0
_UUA_STREAM_BUF=""

# The progress bars' line, and the terminal's settings to restore.
_UUA_LINE="━"
_UUA_STTY=""
_UUA_PROBED_LATE=0

_UUA_FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)


_term_size() {
  local -a size

  size=(${=$(stty size </dev/tty 2>/dev/null)})

  if (( $#size == 2 && size[1] > 0 && size[2] > 0 )); then
    _UUA_LINES=$size[1]
    _UUA_COLS=$size[2]
  elif (( ${LINES:-0} > 0 && ${COLUMNS:-0} > 0 )); then
    _UUA_LINES=$LINES
    _UUA_COLS=$COLUMNS
  fi
}


# $1 repeated $2 times, into REPLY.
_rep() {
  local e=""

  if (( $2 > 0 )); then
    REPLY="${(pl:$2::$1:)e}"
  else
    REPLY=""
  fi
}


# $1 cut or padded to exactly $2 columns, into REPLY. Widths are the
# ones the system reports, so a log line in Chinese is cut right too.
_fit() {
  local s="$1"
  local -i w="$2" n

  if (( w <= 0 )); then
    REPLY=""
    return
  fi

  n=${(m)#s}

  if (( n > w )); then
    s="${s[1,w]}"

    while (( ${(m)#s} > w - 1 )); do
      s="${s[1,-2]}"
    done

    REPLY="$s…"
  else
    _rep " " $(( w - n ))
    REPLY="$s$REPLY"
  fi
}


# Seconds $1 as "0.4s", "12.3s", "1m05s" or "1h02m", into REPLY.
_fmt_secs() {
  local -F t="$1"
  local -i m

  if (( t < 60 )); then
    printf -v REPLY '%.1fs' "$t"
  elif (( t < 3600 )); then
    (( m = t / 60 ))
    printf -v REPLY '%dm%02ds' "$m" "$(( int(t) % 60 ))"
  else
    (( m = t / 60 ))
    printf -v REPLY '%dh%02dm' "$(( m / 60 ))" "$(( m % 60 ))"
  fi
}


# A progress bar $2 columns wide with $1 (0 to 1) of it done, into
# REPLY: a line in color $3 over a faint one of the same length. A job
# that has started shows at least a little of it, and one that has not
# finished never looks done. Without colors it is "=" over "-".
_pbar() {
  local -F f="$1"
  local -i w="$2" n
  local done

  (( f < 0 )) && f=0
  (( f > 1 )) && f=1
  (( n = f * w + 0.5 ))
  (( f > 0 && n == 0 )) && n=1
  (( f < 1 && n >= w && w > 1 )) && (( n = w - 1 ))

  if [[ -n "$C_RESET" ]]; then
    _rep "$_UUA_LINE" "$n"
    done="$REPLY"
    _rep "$_UUA_LINE" "$(( w - n ))"
    REPLY="$3$done$_UUA_GC[track]$REPLY$C_RESET"
  else
    _rep = "$n"
    done="$REPLY"
    _rep - "$(( w - n ))"
    REPLY="$done$REPLY"
  fi
}


# The names of the jobs job $1 still waits for, into REPLY.
_deps_pending() {
  local dep
  local -a names

  for dep in ${=_UUA_J_DEPS[$1]}; do
    [[ -n "$_UUA_J_STATE[$dep]" && "$_UUA_J_STATE[$dep]" != done ]] &&
      names+=("$_UUA_J_NAME[$dep]")
  done

  if (( $#names > 3 )); then
    REPLY="$#names jobs"
  else
    REPLY="${(j:, :)names}"
  fi
}


# The last non-blank line of file $1, stripped of escape sequences and
# control characters, into REPLY. Only its end is read; progress output
# that redraws with carriage returns counts from its last redraw.
_last_log_line() {
  setopt localoptions extendedglob
  local chunk fd
  local -a st lines

  REPLY=""
  zstat -A st +size -- "$1" 2>/dev/null || return 1
  (( st[1] > 0 )) || return 1

  exec {fd}<"$1" || return 1
  (( st[1] > 2048 )) && sysseek -u "$fd" $(( st[1] - 2048 ))
  sysread -i "$fd" -s 2048 chunk
  exec {fd}<&-

  lines=(${(f)${chunk//$'\r'/$'\n'}})
  lines=(${lines:#[[:space:]]#})
  (( $#lines )) || return 1

  REPLY="${lines[-1]//$'\e'\[[0-9;?]#[@-~]/}"
  REPLY="${REPLY//[[:cntrl:]]/}"
  REPLY="${${REPLY##[[:space:]]#}%%[[:space:]]#}"

  [[ -n "$REPLY" ]]
}


# Refreshes what running job $1 is doing and how far it has got. Its
# current phase (see _phase) covers a share of its progress bar; the
# part of it done is counted from the log (lines matching the phase's
# pattern, or a percentage the command printed last) and otherwise eased
# in over time. The bar only ever grows, and fills when the job is done.
# The log's latest line, and the count, are read a few times a second.
_job_watch() {
  local key="$1"
  local f="$_UUA_JOB_DIR/$1.act"
  local act log pat
  local -a a m1 m2 lines
  local -F now=$EPOCHREALTIME p0 p1 tau frac eased cand
  local -i total

  [[ -s "$f" ]] && act="$(<"$f")"

  # Its numbers go into arithmetic, where anything else is fatal to the
  # whole run; a line that is not one the job wrote is passed over.
  if [[ -n "$act" ]]; then
    a=("${(@ps:\t:)act}")
    [[ "${(j::)a[3,5]}$a[7]" != *[^0-9.]* ]] && _UUA_J_ACT[$key]="$act"
  fi

  a=("${(@ps:\t:)_UUA_J_ACT[$key]}")
  log="$a[2]" p0="${a[3]:-0}" p1="${a[4]:-0.9}" tau="${a[5]:-3}" pat="$a[6]" total="${a[7]:-0}"
  (( tau < 0.1 )) && tau=0.1

  # A new log: its latest line is not the old one. A new phase: the
  # count and the easing start over.
  if [[ "$log" != "$_UUA_J_LOG[$key]" ]]; then
    _UUA_J_LOG[$key]="$log"
    _UUA_J_TAIL[$key]=""
    _UUA_J_TAILAT[$key]=0
  fi

  if [[ "$p0 $p1" != "$_UUA_J_PHASE[$key]" ]]; then
    _UUA_J_PHASE[$key]="$p0 $p1"
    _UUA_J_PHASEAT[$key]="$now"
    _UUA_J_FRAC[$key]=-1
  fi

  if (( now - ${_UUA_J_TAILAT[$key]:-0} >= 0.25 )) && [[ -n "$log" ]]; then
    _UUA_J_TAILAT[$key]="$now"

    zstat -A m1 +mtime -- "$log" 2>/dev/null || m1=(0)
    zstat -A m2 +mtime -- "$log.err" 2>/dev/null || m2=(0)

    if (( m2[1] > m1[1] )) && _last_log_line "$log.err"; then
      :
    elif _last_log_line "$log" || _last_log_line "$log.err"; then
      :
    fi

    _UUA_J_TAIL[$key]="$REPLY"

    # (Floats go into the array as strings: assigned in arithmetic,
    # zsh would round them away.)
    if [[ -n "$pat" ]] && (( total > 0 )); then
      [[ -s "$log" ]] && lines=("${(@f)$(<"$log")}")
      lines=(${(M)lines:#${(b)pat}*})
      (( frac = $#lines / (total * 1.0) ))
      _UUA_J_FRAC[$key]="$frac"
    elif [[ "$REPLY" =~ '([0-9]+(\.[0-9]+)?)%' ]] && (( match[1] <= 100 )); then
      (( frac = match[1] / 100.0 ))
      _UUA_J_FRAC[$key]="$frac"
    fi
  fi

  (( eased = 1 - exp(-(now - _UUA_J_PHASEAT[$key]) / tau) ))
  frac="$_UUA_J_FRAC[$key]"

  # While a count stands still (downloads before the first package is
  # set up), time still moves the bar, if more slowly.
  if (( frac >= 0 )); then
    (( frac < eased / 2 )) && (( frac = eased / 2 ))
    (( frac > 1 )) && frac=1
  else
    frac=$eased
  fi

  (( cand = p0 + (p1 - p0) * frac ))
  (( cand > 0.99 )) && cand=0.99
  (( cand > ${_UUA_J_PROG[$key]:-0} )) && _UUA_J_PROG[$key]="$cand"

  return 0
}


# The board's lines into reply; $1 is 1 for the last frame, which
# shows every row with its sub-lines.
_board_lines() {
  local final="$1"
  local -a out keys pri subs
  local -A show
  local key st rs rt icon color name text label tail line pre
  local group prev="" times bar gc

  # Each column starts at its own column number too (CHA), so a
  # character the terminal draws wider than expected cannot push the
  # ones after it out of line.
  local at=$'\e['
  local -i W gut=0 nam=13 tim=7 pb=0 txt ind i n ndone=0 avail bw
  local e0=""

  setopt localoptions extendedglob
  local -F now=$EPOCHREALTIME t0=$_UUA_T0 tmax progress=0

  (( tmax = final ? _UUA_T_END : now ))

  # Columns: group, mark, name, text, progress bar, time. The narrower
  # the terminal, the fewer of them.
  (( W = _UUA_COLS - 1 ))
  (( W > 119 )) && W=119
  (( W >= 60 )) && gut=8

  if (( W >= 70 )); then
    (( pb = W / 5 ))
    (( pb < 10 )) && pb=10
    (( pb > 28 )) && pb=28
  fi

  # The mark gets two columns: "↑" is one of the characters some
  # terminals draw two wide.
  (( txt = W - gut - 3 - nam - tim - (pb ? pb + 2 : 0) ))
  (( ind = gut + 3 + nam ))

  # How far each job has got; the run's progress is their average.
  for key in $_UUA_PLAN; do
    case "$_UUA_J_STATE[$key]" in
      run)
        _job_watch "$key"
        (( progress += ${_UUA_J_PROG[$key]:-0} ))
        ;;

      done)
        (( ndone++ ))
        (( progress += 1 ))
        ;;
    esac
  done

  (( $#_UUA_PLAN )) && (( progress /= $#_UUA_PLAN ))

  # The header: a mark, the run's progress bar and the time so far.
  gc="$_UUA_GC[total]"

  if (( final )); then
    if (( _UUA_INTERRUPTED )); then
      icon="$C_RED✗$C_RESET" gc="$_UUA_GC[failed]"
    elif (( _UUA_FAILED_STEPS )); then
      icon="$C_YELLOW⚠$C_RESET"
    else
      icon="$C_GREEN✓$C_RESET"
    fi
  else
    icon="$C_CYAN$_UUA_FRAMES[$(( _UUA_TICK % $#_UUA_FRAMES + 1 ))]$C_RESET"
  fi

  _fmt_secs $(( tmax - t0 ))
  times="  $ndone/$#_UUA_PLAN  $REPLY"
  (( bw = W - 9 - ${#UUA_VERSION} - ${#times} ))
  (( bw < 4 )) && bw=4
  _pbar "$progress" "$bw" "$gc"

  out+=($'\e[?7l'" $icon ${C_BOLD}UUA$C_RESET $C_DIM$UUA_VERSION$C_RESET  $REPLY$C_BOLD$times$C_RESET" "")

  # A terminal too short for every row shows the running ones first,
  # then failures, then the waiting ones.
  keys=($_UUA_PLAN)
  (( avail = _UUA_LINES - 3 - $#out ))

  if (( ! final && $#keys > avail )); then
    i=0

    for key in $_UUA_PLAN; do
      (( i++ ))

      case "$_UUA_J_STATE[$key]:${_UUA_J_ROW[$key]%%|*}" in
        run:*)       n=0 ;;
        done:failed) n=1 ;;
        wait:*)      n=2 ;;
        *)           n=3 ;;
      esac

      pri+=("$n:${(l:3::0:)i}:$key")
    done

    for line in ${${(o)pri}[1,avail-1]}; do
      show[${line##*:}]=1
    done

    keys=()

    for key in $_UUA_PLAN; do
      (( ${+show[$key]} )) && keys+=("$key")
    done
  fi

  i=0

  for key in $keys; do
    (( i++ ))

    st="$_UUA_J_STATE[$key]"
    group="$_UUA_J_GROUP[$key]"
    gc="$_UUA_GC[$group]"
    pre=""

    if (( gut )); then
      if [[ "$group" != "$prev" ]]; then
        pre=" ${gc:-$C_DIM}${(r:6:)${(U)group}}$C_RESET "
      else
        pre="        "
      fi
    fi

    prev="$group"
    _fit "$_UUA_J_NAME[$key]" $(( nam - 1 ))
    name="$REPLY "
    times=""

    case "$st" in
      wait)
        icon="$C_DIM$_UUA_ICON[wait]$C_RESET"
        name="$C_DIM$name$C_RESET"
        _deps_pending "$key"
        _fit "waiting${REPLY:+ for $REPLY}" "$txt"
        text="$C_DIM$REPLY$C_RESET"
        _pbar 0 "$pb" "$gc"
        bar="$REPLY"
        ;;

      run)
        (( n = (_UUA_TICK + i) % $#_UUA_FRAMES + 1 ))
        icon="$C_MAGENTA$_UUA_FRAMES[n]$C_RESET"
        name="$C_BOLD$name$C_RESET"

        label="${_UUA_J_ACT[$key]%%$'\t'*}"
        [[ -n "$label" ]] || label="starting"
        (( _UUA_STOPPING )) && label="finishing safely · $label"
        tail="$_UUA_J_TAIL[$key]"

        if (( ${(m)#label} >= txt || ${#tail} == 0 || txt - ${(m)#label} < 8 )); then
          _fit "$label" "$txt"
          text="$REPLY"
        else
          _fit "  $tail" $(( txt - ${(m)#label} ))
          text="$label$C_DIM$REPLY$C_RESET"
        fi

        _pbar "${_UUA_J_PROG[$key]:-0}" "$pb" "$gc"
        bar="$REPLY"
        _fmt_secs $(( now - _UUA_J_START[$key] ))
        times="$REPLY"
        ;;

      *)
        rs="${_UUA_J_ROW[$key]%%|*}"
        rt="${_UUA_J_ROW[$key]#*|}"

        _state_color "$rs"
        color="$REPLY"
        icon="$color$_UUA_ICON[$rs]$C_RESET"

        _fit "$rt" "$txt"

        case "$rs" in
          ok)     text="$REPLY" ;;
          absent) text="$C_DIM$REPLY$C_RESET" name="$C_DIM$name$C_RESET" ;;
          *)      text="$color$REPLY$C_RESET" ;;
        esac

        if [[ "$rs" == absent ]]; then
          _rep " " "$pb"
          bar="$REPLY"
        else
          [[ "$rs" == failed ]] && gc="$_UUA_GC[failed]"
          _pbar 1 "$pb" "$gc"
          bar="$REPLY"
          _fmt_secs $(( _UUA_J_END[$key] - _UUA_J_START[$key] ))
          times="$C_DIM$REPLY$C_RESET"
        fi
        ;;
    esac

    # Rows never wrap, not even in the last frame; sub-lines may.
    line=$'\e[?7l'"${at}1G$pre$at$(( gut + 1 ))G$icon  $at$(( gut + 4 ))G$name$at$(( ind + 1 ))G$text"
    (( pb )) && line+="  $at$(( ind + txt + 3 ))G$bar"

    _fit "" $(( tim - ${#${times//$'\e'\[[0-9;]#m/}} ))
    out+=("$line$at$(( W - tim + 1 ))G$REPLY$times")

    if (( final )) && [[ -s "$_UUA_JOB_DIR/$key.sub" ]]; then
      subs=("${(@f)$(<"$_UUA_JOB_DIR/$key.sub")}")

      for line in $subs; do
        _fmt_line "${line%%|*}" "${line#*|}"
        out+=($'\e[?7h'"${(l:ind:: :)e0}$at$(( ind + 1 ))G$REPLY")
      done
    fi
  done

  (( $#keys < $#_UUA_PLAN )) &&
    out+=("$C_DIM${(l:ind:: :)e0}$at$(( ind + 1 ))G… $(( $#_UUA_PLAN - $#keys )) more$C_RESET")

  reply=("${out[@]}")
}


# New complete lines of the --verbose stream, into reply.
_stream_take() {
  local chunk line complete

  reply=()
  [[ -n "$_UUA_STREAM" ]] || return 0

  if (( ! _UUA_STREAM_FD )); then
    [[ -r "$_UUA_STREAM" ]] || return 0
    exec {_UUA_STREAM_FD}<"$_UUA_STREAM"
  fi

  while sysread -i "$_UUA_STREAM_FD" -s 65536 chunk; do
    _UUA_STREAM_BUF+="$chunk"
  done

  [[ "$_UUA_STREAM_BUF" == *$'\n'* ]] || return 0

  complete="${_UUA_STREAM_BUF%$'\n'*}"
  _UUA_STREAM_BUF="${_UUA_STREAM_BUF##*$'\n'}"

  for line in "${(@f)complete}"; do
    reply+=("${line##*$'\r'}")
  done
}


# True when the terminal draws East Asian ambiguous-width characters,
# "━" among them, two columns wide, as many CJK setups do: it is asked
# where the cursor went after drawing one ("ESC [ row ; col R"). The
# terminal must be in non-canonical mode. The answer is read a byte at a
# time against a deadline (read -t only waits for the first byte, then
# blocks), so a key pressed meanwhile cannot hang the run. A terminal
# that does not answer in time counts as narrow; its answer may still
# come, and _tty_restore swallows it.
_ambiguous_wide() {
  local reply="" c
  local -F deadline

  printf '\r━\033[6n' >/dev/tty
  (( deadline = EPOCHREALTIME + 0.5 ))

  while (( EPOCHREALTIME < deadline )); do
    IFS= read -r -s -k 1 -t 0.05 c </dev/tty || continue
    reply+="$c"
    [[ "$c" == R ]] && break
  done

  printf '\r\033[2K' >/dev/tty

  if [[ "$reply" != *$'\e['*\;*R ]]; then
    _UUA_PROBED_LATE=1
    return 1
  fi

  reply="${reply%R}"
  [[ "${reply##*;}" == 3 ]]
}


# Puts the terminal back as it was, first swallowing a late answer to
# _ambiguous_wide, which would otherwise land in the shell's input.
_tty_restore() {
  local c

  [[ -n "$_UUA_STTY" ]] || return 0

  if (( _UUA_PROBED_LATE )); then
    for c in {1..64}; do
      IFS= read -r -s -k 1 -t 0.1 c </dev/tty || break
    done
  fi

  stty "$_UUA_STTY" </dev/tty 2>/dev/null
  _UUA_STTY=""
}


_board_begin() {
  if [[ -t 1 && "$TERM" != dumb ]]; then
    _UUA_LIVE=1
    _term_size
    trap '_term_size' WINCH

    # Keys typed while the board runs are not echoed over it.
    _UUA_STTY="$(stty -g </dev/tty 2>/dev/null)"

    if [[ -n "$_UUA_STTY" ]] && stty -echo -icanon </dev/tty 2>/dev/null; then
      _ambiguous_wide && _UUA_LINE="-"
    fi

    # No autowrap while the board redraws: a row wider than the
    # terminal thinks it is is cut at the edge rather than wrapped,
    # which would throw every redraw after it out of place.
    printf '\n\033[?25l\033[?7l'
  else
    _UUA_LIVE=0
    print -r -- "${C_BOLD}UUA $UUA_VERSION$C_RESET $C_DIM· $#_UUA_PLAN jobs$C_RESET"
  fi
}


# Redraws the board over its last frame. --verbose lines go above it and
# scroll away; the board stays at the bottom.
_board_draw() {
  local out="" line
  local -a stream

  (( _UUA_TICK++ ))

  _stream_take
  stream=("${reply[@]}")

  if (( ! _UUA_LIVE )); then
    (( $#stream )) && print -rl -- "${stream[@]}"
    return 0
  fi

  _board_lines 0

  (( _UUA_DRAWN )) && out+=$'\e['"${_UUA_DRAWN}A"
  out+=$'\r'

  # The stream wraps like any output: it scrolls away above the board.
  if (( $#stream )); then
    out+=$'\e[J\e[?7h'

    for line in "${stream[@]}"; do
      out+="$line"$'\n'
    done

    out+=$'\e[?7l'
  fi

  for line in "${reply[@]}"; do
    out+=$'\e[2K'"$line"$'\n'
  done

  out+=$'\e[J'
  printf '%s' "$out"

  _UUA_DRAWN=$#reply
}


# The last frame, or for a run without a board the rest of the stream.
_board_end() {
  local out="" line
  local -a stream

  _stream_take
  stream=("${reply[@]}")

  if (( ! _UUA_LIVE )); then
    (( $#stream )) && print -rl -- "${stream[@]}"
    return 0
  fi

  trap - WINCH
  _board_lines 1

  # The last frame stays, so its sub-lines may wrap.
  (( _UUA_DRAWN )) && out+=$'\e['"${_UUA_DRAWN}A"
  out+=$'\r\e[J\e[?7h'

  for line in "${stream[@]}" "${reply[@]}"; do
    out+="$line"$'\n'
  done

  printf '%s\033[?7h\033[?25h' "$out"
  _tty_restore

  _UUA_LIVE=0
  _UUA_DRAWN=0
}


# A finished job for a run without a board: its row, time and
# sub-lines.
_print_job() {
  local key="$1"
  local rs="${_UUA_J_ROW[$1]%%|*}"
  local rt="${_UUA_J_ROW[$1]#*|}"
  local line
  local -F took

  _fmt_line "$rs" "${(r:12:)_UUA_J_NAME[$key]} $rt"
  line="$REPLY"

  if [[ "$rs" != absent ]]; then
    (( took = _UUA_J_END[$key] - _UUA_J_START[$key] ))
    _fmt_secs "$took"
    line+="  $C_DIM($REPLY)$C_RESET"
  fi

  print -r -- "$line"

  [[ -s "$_UUA_JOB_DIR/$key.sub" ]] || return 0

  for line in "${(@f)$(<"$_UUA_JOB_DIR/$key.sub")}"; do
    _fmt_line "${line%%|*}" "${line#*|}"
    print -r -- "               $REPLY"
  done
}


# ─────────────────────────────────────────────────────────────
# Cleanup
# ─────────────────────────────────────────────────────────────

# Keeps this run's logs when asked to or when something went wrong, and
# only the newest _UUA_LOGS_KEPT runs' logs overall.
_finish_logs() {
  local -a old

  [[ -n "$_UUA_RUN_DIR" && -d "$_UUA_RUN_DIR" ]] || return 0

  if (( _UUA_KEEP_LOGS || _UUA_FAILED_STEPS || _UUA_INTERRUPTED )); then
    _info "Logs kept in $_UUA_RUN_DIR"
  else
    rm -rf -- "$_UUA_RUN_DIR"
  fi

  old=("$_UUA_LOG_ROOT"/run-*(N/On))
  old=(${old[$(( _UUA_LOGS_KEPT + 1 )),-1]})

  (( $#old )) && rm -rf -- $old

  return 0
}


_cleanup() {
  local pid

  # The signal traps call this and then exit, firing the EXIT trap too.
  (( _UUA_CLEANED )) && return 0
  _UUA_CLEANED=1

  # A second signal (Ctrl-C, then closing the terminal) must not cut
  # the cleanup short and leave children running.
  trap '' INT TERM HUP

  (( _UUA_PLAN_ACTIVE )) && _plan_stop

  # Jobs and queries write into the run directory, so they (and
  # whatever they started) have to be gone before it is removed.
  for pid in $_UUA_CHILD_PIDS $_UUA_SUDO_REFRESH_PID; do
    _is_my_child "$pid" && _kill_tree "$pid"
  done

  for pid in $_UUA_CHILD_PIDS $_UUA_SUDO_REFRESH_PID; do
    wait "$pid" 2>/dev/null
  done

  _UUA_CHILD_PIDS=()
  _UUA_SUDO_REFRESH_PID=""

  [[ -t 1 ]] && printf '\033[?25h\033[?7h'
  _tty_restore
  (( _UUA_STREAM_FD )) && exec {_UUA_STREAM_FD}<&-

  _release_run_lock
  _finish_logs

  return 0
}


_on_signal() {
  _UUA_INTERRUPTED=1
  _cleanup
  exit "$1"
}


# ─────────────────────────────────────────────────────────────
# Help
# ─────────────────────────────────────────────────────────────

_usage() {
  local row
  local -a labels

  for row in $_UUA_TOOLS; do
    _tool_fields "$row"
    labels+=("$reply[2]")
  done

  cat <<EOF
UUA $UUA_VERSION — Universal Update All

Updates APT packages, Node.js (through nvm), npm, Bun, the global
npm/bun packages and a set of AI coding CLIs in one run.

Usage: uua [options]

Options:
  --check       Report available updates without installing or removing
                anything. Asks for no sudo password; APT is checked
                against the package metadata already on disk.
  --prune       Also remove what the updates superseded: Node.js
                releases older than the LTS, Codex releases other than
                the current one, and APT packages nothing needs. A
                release a running process uses is kept.
  --apt         Only the APT group
  --node        Only the Node.js group: node, npm, bun and the global
                npm/bun packages
  --ai          Only the AI CLI group
  --verbose     Show the output of every command as it runs, each line
                prefixed with the log it comes from ("[npm-install]",
                "[claude]"); on a terminal the board stays below it
  --keep-logs   Keep this run's logs (kept anyway when anything fails)
  --no-color    Disable colors (so does NO_COLOR)
  --version     Print the version
  -h, --help    Show this help

Group flags combine ("uua --apt --ai"); without one every group runs.
The sudo password is asked for once, before anything runs, and only
when the APT group runs outside --check.

How it runs:
  Every step is a job, and a job starts as soon as the ones it builds
  on have finished:
    apt
    node → npm → npm globals
    bun → bun globals (after node too: it looks packages up with npm)
    AI CLIs (${(j:, :)labels}): from the start when they
      update themselves; after apt, npm or bun when that package
      manager installed them
  With --prune, old Node.js releases are removed last. --check changes
  nothing, so every job starts at once. The registry and release
  queries all go out first, while the sudo password is typed.

  On a terminal a live board shows each job's state, what it is doing
  and the latest line of its log, and a progress bar in the color of its
  group (apt, node, bun, AI CLIs), under a bar for the whole run; the
  last frame stays, with the details. Elsewhere each job prints once,
  when it finishes.

AI CLIs:
  A tool whose executable apt owns is left to apt. Pi's extension
  packages are refreshed with "pi update --extensions" whenever pi is
  installed; --check skips them, as pi has no dry run.

Node.js:
  Installs the latest LTS through nvm. The default alias moves to
  lts/* only when it is unset, dangling, or names the exact release
  being replaced; a pin ("22", "lts/iron", "system", ...) stays, and
  the later jobs then update the pinned Node, the one new shells get.
  nvm itself is not updated: it has no self-update command.

Global packages:
  Every npm -g and bun -g package installed from a registry, except
  the ones the jobs above own. Linked, local and git packages are left
  alone.

Removal:
  Nothing is removed without --prune; without it, uua reports what
  --prune would remove.

Time limits:
  ${_UUA_QUERY_LIMIT}s per version query, $(( _UUA_INSTALL_LIMIT / 60 ))min per install, $(( _UUA_WORKER_LIMIT / 60 ))min per AI CLI. APT has
  none: dpkg must not be killed halfway through, and Ctrl-C waits for
  it to finish.

Logs:
  $_UUA_LOG_ROOT/run-<time>-<pid>
  Removed after a clean run unless --keep-logs is given; the newest
  $_UUA_LOGS_KEPT runs are kept.

Exit status:
  0    everything is up to date or was updated
  1    something failed, or another run is in progress
  2    invalid option
  100  --check found updates
EOF
}


# ─────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────

# True when the group named by $1 (a _UUA_WANT_* flag) should run:
# without a filter flag every group runs, with one only the selected
# groups do.
_group_enabled() {
  (( _UUA_FILTERED )) || return 0

  (( $1 ))
}


_summary() {
  local key line speed
  local -i total ran=0
  local -F wall work=0

  (( total = _UUA_UPTODATE + _UUA_UPDATED + _UUA_AVAILABLE + _UUA_FAILED_STEPS ))
  (( wall = _UUA_T_END - _UUA_T0 ))

  for key in $_UUA_PLAN; do
    [[ "${_UUA_J_ROW[$key]%%|*}" == absent ]] && continue

    (( work += _UUA_J_END[$key] - _UUA_J_START[$key] ))
    (( ran++ ))
  done

  line=" ${C_BOLD}Summary$C_RESET  $total item(s)"
  line+="  $C_GREEN✓$C_RESET $_UUA_UPTODATE up to date"
  line+="  $C_CYAN↑$C_RESET $_UUA_UPDATED upgraded"
  line+="  $C_RED✗$C_RESET $_UUA_FAILED_STEPS failed"

  (( _UUA_AVAILABLE )) &&
    line+="  $C_YELLOW↑$C_RESET $_UUA_AVAILABLE update(s) available"

  printf '\n%s\n' "$line"

  _fmt_secs "$wall"
  line=" ${C_BOLD}Time$C_RESET     $REPLY"

  # How much the jobs overlapped: their running times added up, against
  # the time the run took.
  if (( ran > 1 && wall >= 0.5 )); then
    _fmt_secs "$work"
    printf -v speed '%.1f' $(( work / wall ))
    line+="  $C_DIM·  $REPLY of work in $ran jobs, ${speed}× in parallel$C_RESET"
  fi

  print -r -- "$line"

  if (( _UUA_NODE_CHANGED )); then
    printf '\n'
    _info "This shell's Node.js is no longer the default. Refresh it with:"
    printf '   %snvm use default%s\n' "$C_CYAN" "$C_RESET"
  fi

  if (( _UUA_REBOOT )); then
    printf '\n'
    _info "A reboot is required to finish the APT upgrade"
  fi

  printf '\n'
}


main() {
  local stamp

  while (( $# > 0 )); do
    case "$1" in
      --check)     _UUA_CHECK_ONLY=1 ;;
      --prune)     _UUA_PRUNE=1 ;;
      --keep-logs) _UUA_KEEP_LOGS=1 ;;
      --no-color)  _UUA_NO_COLOR=1 ;;
      --verbose)   _UUA_VERBOSE=1 ;;
      --apt)       _UUA_WANT_APT=1 _UUA_FILTERED=1 ;;
      --node)      _UUA_WANT_NODE=1 _UUA_FILTERED=1 ;;
      --ai)        _UUA_WANT_AI=1 _UUA_FILTERED=1 ;;

      --version)
        print -r -- "UUA $UUA_VERSION"
        return 0
        ;;

      -h|--help)
        _usage
        return 0
        ;;

      *)
        print -r -- "Unknown option: $1" >&2
        print -r -- 'Run "uua --help" for usage.' >&2
        return 2
        ;;
    esac

    shift
  done

  _init_colors

  trap '_cleanup' EXIT
  trap '_on_signal 130' INT
  trap '_on_signal 143' TERM
  trap '_on_signal 129' HUP

  if ! mkdir -p "$_UUA_LOG_ROOT"; then
    _fail "Unable to create $_UUA_LOG_ROOT"
    return 1
  fi

  # --check changes nothing, so it can run beside an updating run.
  if (( ! _UUA_CHECK_ONLY )) && ! _acquire_run_lock; then
    _fail "Another uua run is in progress (pid $REPLY)"
    return 1
  fi

  strftime -s stamp '%Y%m%d-%H%M%S' "$EPOCHSECONDS"
  _UUA_RUN_DIR="$_UUA_LOG_ROOT/run-$stamp-$$"

  if ! mkdir -m 700 "$_UUA_RUN_DIR" ||
    ! mkdir "$_UUA_RUN_DIR/jobs" "$_UUA_RUN_DIR/cache"
  then
    _fail "Unable to create the log directory $_UUA_RUN_DIR"
    _UUA_RUN_DIR=""
    return 1
  fi

  _UUA_JOB_DIR="$_UUA_RUN_DIR/jobs"
  _UUA_CACHE="$_UUA_RUN_DIR/cache"

  if (( _UUA_VERBOSE )); then
    _UUA_STREAM="$_UUA_RUN_DIR/verbose.log"
    : >"$_UUA_STREAM"
  fi

  # Every job works on the Node new shells get, nvm's default, from the
  # start: the node job hands on a newer one when it installs it. The
  # invoking shell's own is remembered, for the note that it changed.
  if _group_enabled _UUA_WANT_NODE || _group_enabled _UUA_WANT_AI; then
    if _load_nvm; then
      _UUA_ACTIVE_NODE="$(_strip_v "$(nvm current 2>/dev/null)")"
      _use_default_node
    fi

    _resolve_npm_root
  fi

  _plan_build
  _prefetch_all

  # The sudo password comes before the board, while no redraw can hide
  # the prompt; the queries above are already out. --check never needs
  # root, and neither does a run without the apt group.
  if (( ! _UUA_CHECK_ONLY )) && _group_enabled _UUA_WANT_APT; then
    _collect_sudo_password || return 1
  fi

  _plan_run
  _summary

  (( _UUA_FAILED_STEPS )) && return 1
  (( _UUA_CHECK_ONLY && _UUA_AVAILABLE )) && return 100

  return 0
}


# Sourcing the script (as the tests do) defines the functions without
# running anything.
if [[ "$ZSH_EVAL_CONTEXT" == toplevel ]]; then
  main "$@"
fi
